{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "rocketDAOProtocolProposal",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x2D627A50Dc1C4EDa73E42858E8460b0eCF300b25" }] }
  },
  "metadata": {
    "owner": "Rocket Pool",
    "info": { "url": "https://rocketpool.net" },
    "enums": { "voteDirection": { "0": "No vote", "1": "Abstain", "2": "For", "3": "Against", "4": "Against with veto" } },
    "contractName": "rocketDAOProtocolProposal"
  },
  "display": {
    "formats": {
      "propose(string _proposalMessage, bytes _payload, uint32 _blockNumber, (uint256 sum, bytes32 hash)[] _treeNodes)": {
        "intent": "Submit pDAO proposal, lock RPL bond",
        "interpolatedIntent": "Submit pDAO proposal and lock the RPL bond: {_proposalMessage}",
        "fields": [
          { "label": "Message", "format": "raw", "path": "#._proposalMessage", "visible": "always" },
          { "label": "Block number", "format": "raw", "path": "#._blockNumber", "visible": "always" },
          { "label": "Payload (executed if passed)", "format": "raw", "path": "#._payload", "visible": "always" },
          { "label": "Tree nodes", "path": "#._treeNodes.[]", "visible": "never" }
        ]
      },
      "vote(uint256 _proposalID, uint8 _voteDirection, uint256 _votingPower, uint256 _nodeIndex, (uint256 sum, bytes32 hash)[] _witness)": {
        "intent": "Vote on pDAO proposal",
        "interpolatedIntent": "Vote {_voteDirection} on pDAO proposal {_proposalID}",
        "fields": [
          { "label": "Proposal ID", "format": "raw", "path": "#._proposalID", "visible": "always" },
          {
            "label": "Vote",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.voteDirection" },
            "path": "#._voteDirection",
            "visible": "always"
          },
          {
            "label": "Voting power",
            "format": "unit",
            "path": "#._votingPower",
            "visible": "always",
            "params": { "base": "votes", "decimals": 18 }
          },
          { "label": "Node index", "path": "#._nodeIndex", "visible": "never" },
          { "label": "Witness", "path": "#._witness.[]", "visible": "never" }
        ]
      },
      "overrideVote(uint256 _proposalID, uint8 _voteDirection)": {
        "intent": "Override delegate vote",
        "interpolatedIntent": "Override delegate vote to {_voteDirection} on pDAO proposal {_proposalID}",
        "fields": [
          { "label": "Proposal ID", "format": "raw", "path": "#._proposalID", "visible": "always" },
          {
            "label": "Vote",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.voteDirection" },
            "path": "#._voteDirection",
            "visible": "always"
          }
        ]
      },
      "finalise(uint256 _proposalID)": {
        "intent": "Finalise pDAO proposal",
        "interpolatedIntent": "Finalise pDAO proposal {_proposalID}",
        "fields": [{ "label": "Proposal ID", "format": "raw", "path": "#._proposalID", "visible": "always" }]
      },
      "execute(uint256 _proposalID)": {
        "intent": "Execute pDAO proposal",
        "interpolatedIntent": "Execute pDAO proposal {_proposalID}",
        "fields": [{ "label": "Proposal ID", "format": "raw", "path": "#._proposalID", "visible": "always" }]
      }
    }
  }
}
