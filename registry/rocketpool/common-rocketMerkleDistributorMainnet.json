{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {}
  },
  "metadata": {
    "constants": {
      "RPLaddress": "0x0"
    }
  },
  "display": {
    "formats": {
      "claim(address _nodeAddress, (uint256 rewardIndex, uint256 amountRPL, uint256 amountSmoothingPoolETH, uint256 amountVoterETH, bytes32[] merkleProof)[] _claims)": {
        "intent": "Claim rewards",
        "interpolatedIntent": "Claim rewards for {_nodeAddress}",
        "fields": [
          {
            "label": "Node",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "path": "#._nodeAddress",
            "visible": "always"
          },
          {
            "label": "RPL claimed",
            "format": "tokenAmount",
            "path": "#._claims.[].amountRPL",
            "params": {
              "token": "$.metadata.constants.RPLaddress"
            },
            "visible": "always"
          },
          {
            "label": "Smoothing pool ETH",
            "format": "amount",
            "path": "#._claims.[].amountSmoothingPoolETH",
            "visible": "always"
          },
          {
            "label": "Voter ETH",
            "format": "amount",
            "path": "#._claims.[].amountVoterETH",
            "visible": "always"
          },
          {
            "label": "Reward index",
            "path": "#._claims.[].rewardIndex",
            "visible": "never"
          },
          {
            "label": "Merkle proof",
            "path": "#._claims.[].merkleProof.[]",
            "visible": "never"
          }
        ]
      },
      "claimAndStake(address _nodeAddress, (uint256 rewardIndex, uint256 amountRPL, uint256 amountSmoothingPoolETH, uint256 amountVoterETH, bytes32[] merkleProof)[] _claims, uint256 _stakeAmount)": {
        "intent": "Claim and stake rewards",
        "interpolatedIntent": "Claim rewards for {_nodeAddress} and stake {_stakeAmount}",
        "fields": [
          {
            "label": "Node",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "path": "#._nodeAddress",
            "visible": "always"
          },
          {
            "label": "RPL claimed",
            "format": "tokenAmount",
            "path": "#._claims.[].amountRPL",
            "params": {
              "token": "$.metadata.constants.RPLaddress"
            },
            "visible": "always"
          },
          {
            "label": "RPL re-staked",
            "format": "tokenAmount",
            "path": "#._stakeAmount",
            "params": {
              "token": "$.metadata.constants.RPLaddress"
            },
            "visible": "always"
          },
          {
            "label": "Smoothing pool ETH",
            "format": "amount",
            "path": "#._claims.[].amountSmoothingPoolETH",
            "visible": "always"
          },
          {
            "label": "Voter ETH",
            "format": "amount",
            "path": "#._claims.[].amountVoterETH",
            "visible": "always"
          },
          {
            "label": "Reward index",
            "path": "#._claims.[].rewardIndex",
            "visible": "never"
          },
          {
            "label": "Merkle proof",
            "path": "#._claims.[].merkleProof.[]",
            "visible": "never"
          }
        ]
      },
      "claimOutstandingEth()": {
        "intent": "Claim outstanding ETH",
        "interpolatedIntent": "Claim outstanding ETH",
        "fields": []
      }
    }
  }
}
