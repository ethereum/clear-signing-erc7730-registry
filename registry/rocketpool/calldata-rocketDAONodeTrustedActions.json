{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "rocketDAONodeTrustedActions",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x029d946F28F93399a5b0D09c879FC8c94E596AEb" },
        { "chainId": 560048, "address": "0xa0f327589B08CEB824c21CDe8eaD5a3e6ca9edF7" }
      ]
    }
  },
  "metadata": { "owner": "Rocket Pool", "info": { "url": "https://rocketpool.net" }, "contractName": "rocketDAONodeTrustedActions" },
  "display": {
    "formats": {
      "actionJoin()": { "intent": "Join oracle DAO, pay RPL bond", "interpolatedIntent": "Join oracle DAO and pay the RPL bond", "fields": [] },
      "actionLeave(address _rplBondRefundAddress)": {
        "intent": "Leave oracle DAO",
        "interpolatedIntent": "Leave oracle DAO, refund bond to {_rplBondRefundAddress}",
        "fields": [
          {
            "label": "Refund address",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] },
            "path": "#._rplBondRefundAddress",
            "visible": "always"
          }
        ]
      },
      "actionChallengeMake(address _nodeAddress)": {
        "intent": "Challenge oracle DAO member",
        "interpolatedIntent": "Challenge {_nodeAddress} paying {@.value}",
        "fields": [
          {
            "label": "Node",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] },
            "path": "#._nodeAddress",
            "visible": "always"
          },
          { "label": "Challenge fee (not refunded)", "format": "amount", "path": "@.value", "visible": "always" }
        ]
      },
      "actionChallengeDecide(address _nodeAddress)": {
        "intent": "Decide oracle DAO challenge",
        "interpolatedIntent": "Decide challenge against {_nodeAddress}",
        "fields": [
          {
            "label": "Node",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] },
            "path": "#._nodeAddress",
            "visible": "always"
          }
        ]
      }
    }
  }
}
