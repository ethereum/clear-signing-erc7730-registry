{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "AllowanceHolder",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" },
        { "chainId": 10, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" },
        { "chainId": 130, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" },
        { "chainId": 8453, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" },
        { "chainId": 42161, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" },
        { "chainId": 57073, "address": "0x50c4E75a512F2A14A7b304787Adf79C4531A5909" }
      ]
    }
  },
  "metadata": {
    "owner": "Socket",
    "info": { "url": "https://socket.tech" },
    "constants": { "addressAsEth": "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE" },
    "contractName": "AllowanceHolder"
  },
  "display": {
    "formats": {
      "exec(address operator, address token, uint256 amount, address target, bytes data)": {
        "$id": "exec",
        "intent": "Run with token allowance",
        "interpolatedIntent": "Run using up to {amount}",
        "fields": [
          {
            "path": "amount",
            "label": "Token allowance",
            "format": "tokenAmount",
            "params": { "tokenPath": "token", "nativeCurrencyAddress": "$.metadata.constants.addressAsEth" },
            "visible": "always"
          },
          {
            "path": "operator",
            "label": "Allowed spender",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local"] },
            "visible": "always"
          },
          { "path": "@.value", "label": "Native token sent", "format": "amount", "visible": "always" },
          {
            "path": "target",
            "label": "Called contract",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local"] },
            "visible": "always"
          },
          {
            "path": "data",
            "label": "Request",
            "format": "calldata",
            "params": { "calleePath": "target", "amountPath": "@.value", "spenderPath": "@.to" },
            "visible": "always"
          }
        ]
      }
    }
  }
}
