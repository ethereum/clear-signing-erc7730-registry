{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Cofund",
    "eip712": {
      "deployments": [
        { "chainId": 1, "address": "0xD59eFC1803Fb72231Db0B6A872a9c22D8A0102C0" },
        { "chainId": 4663, "address": "0xF3B43952BcC2560789be8076529df8F908cEf535" }
      ],
      "domain": { "name": "Cofund", "version": "1" }
    }
  },
  "metadata": { "owner": "Cofund", "info": { "url": "https://getcofund.com" }, "contractName": "Cofund Treasury" },
  "display": {
    "formats": {
      "InviteUser(string company,string callerId,string userId,bool userIsAdmin,string userPosition,uint256 expiresAt,string authId)": {
        "$id": "invite-user",
        "intent": "Invite member",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "callerId", "label": "Invited by", "format": "raw", "visible": "always" },
          { "path": "userId", "label": "Member ID", "format": "raw", "visible": "always" },
          { "path": "userIsAdmin", "label": "Admin rights", "format": "raw", "visible": "always" },
          { "path": "userPosition", "label": "Position", "format": "raw", "visible": "always" },
          { "path": "expiresAt", "label": "Expires", "format": "date", "params": { "encoding": "timestamp" }, "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "RemoveUser(string company,string removedUserId,string authId)": {
        "$id": "remove-user",
        "intent": "Remove member",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "removedUserId", "label": "Member ID", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "RotateUser(string company,string userId,address newAddress,string authId)": {
        "$id": "rotate-user",
        "intent": "Rotate signing key",
        "interpolatedIntent": "Move member {userId} to {newAddress}",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "userId", "label": "Member ID", "format": "raw", "visible": "always" },
          {
            "path": "newAddress",
            "label": "New key",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "CompleteOnboarding(string company,string authId)": {
        "$id": "complete-onboarding",
        "intent": "Complete onboarding",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "TransferPolicyActivation(string company,string policyId,string title,string policyType,string[] signerIds,uint256 threshold,address token,uint256 maxAmount,address[] recipients,string authId)": {
        "$id": "transfer-policy-activation",
        "intent": "Activate transfer policy",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "title", "label": "Policy", "format": "raw", "visible": "always" },
          { "path": "policyId", "label": "Policy ID", "format": "raw", "visible": "always" },
          { "path": "policyType", "label": "Policy type", "format": "raw", "visible": "always" },
          { "path": "signerIds.[]", "label": "Signer", "format": "raw", "visible": "always" },
          { "path": "threshold", "label": "Signatures required", "format": "raw", "visible": "always" },
          {
            "path": "token",
            "label": "Token",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] },
            "visible": "always"
          },
          {
            "path": "maxAmount",
            "label": "Max per transfer",
            "format": "tokenAmount",
            "params": { "tokenPath": "token" },
            "visible": "always"
          },
          {
            "path": "recipients.[]",
            "label": "Allowed recipient",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "TransactionPolicyActivation(string company,string policyId,string title,string policyType,string[] signerIds,uint256 threshold,address wrapper,string func,string authId)": {
        "$id": "transaction-policy-activation",
        "intent": "Activate transaction policy",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "title", "label": "Policy", "format": "raw", "visible": "always" },
          { "path": "policyId", "label": "Policy ID", "format": "raw", "visible": "always" },
          { "path": "policyType", "label": "Policy type", "format": "raw", "visible": "always" },
          { "path": "signerIds.[]", "label": "Signer", "format": "raw", "visible": "always" },
          { "path": "threshold", "label": "Signatures required", "format": "raw", "visible": "always" },
          {
            "path": "wrapper",
            "label": "Contract",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local"] },
            "visible": "always"
          },
          { "path": "func", "label": "Function", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "PolicyDeactivation(string company,string policyId,string authId)": {
        "$id": "policy-deactivation",
        "intent": "Deactivate policy",
        "interpolatedIntent": "Deactivate policy {policyId}",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "policyId", "label": "Policy ID", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "Transfer(string company,string policyId,string messageType,uint256 amount,address token,address recipient,string authId)": {
        "$id": "vault-transfer",
        "intent": "Approve transfer",
        "interpolatedIntent": "Approve transfer of {amount} to {recipient}",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          { "path": "amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "token" }, "visible": "always" },
          {
            "path": "token",
            "label": "Token",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] },
            "visible": "always"
          },
          {
            "path": "recipient",
            "label": "To",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "policyId", "label": "Policy ID", "format": "raw", "visible": "always" },
          { "path": "messageType", "label": "Policy type", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      },
      "Transaction(string company,string policyId,string messageType,address wrapper,string func,Allowance[] allowances,bytes32 instructionsHash,string authId)Allowance(address asset,uint256 amount)": {
        "$id": "vault-transaction",
        "intent": "Approve transaction",
        "fields": [
          { "path": "company", "label": "Company", "format": "raw", "visible": "always" },
          {
            "path": "wrapper",
            "label": "Contract",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local"] },
            "visible": "always"
          },
          { "path": "func", "label": "Function", "format": "raw", "visible": "always" },
          {
            "path": "allowances.[]",
            "fields": [
              {
                "path": "asset",
                "label": "Approve token",
                "format": "addressName",
                "params": { "types": ["token"], "sources": ["local"] },
                "visible": "always"
              },
              {
                "path": "amount",
                "label": "Approve amount",
                "format": "tokenAmount",
                "params": { "tokenPath": "asset" },
                "visible": "always"
              }
            ]
          },
          { "path": "instructionsHash", "label": "Hash (see Cofund)", "format": "raw", "visible": "always" },
          { "path": "policyId", "label": "Policy ID", "format": "raw", "visible": "always" },
          { "path": "messageType", "label": "Policy type", "format": "raw", "visible": "always" },
          { "path": "authId", "label": "Authorization ID", "format": "raw", "visible": "never" }
        ]
      }
    }
  },
  "$comment": "Cofund protocol v1: member, policy and vault authorizations share the State domain. Transaction binds wrapper instructions by hash; Transfer amount is principal and excludes fees. Empty policy recipients are unrestricted. Schema is ERC-7730 v2."
}
