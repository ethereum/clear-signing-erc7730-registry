{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Roles",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x9646fDAD06d3e24444381f44362a3B0eB343D337" },
        { "chainId": 10, "address": "0x9646fDAD06d3e24444381f44362a3B0eB343D337" },
