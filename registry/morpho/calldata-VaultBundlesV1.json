  "display": {
    "formats": {
      "vaultBundlesV1Deposit(address vault, uint256 assets, uint256 maxSharePriceE27, (uint8 kind, bytes data) assetPermit, uint256 referralFeePct, address referralFeeRecipient, uint256 deadline)": {
        "intent": "Deposit to vault",
        "interpolatedIntent": "Deposit to vault with {#.referralFeePct} referral fee",
        "fields": [
          {
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["contract", "token"] },
            "path": "#.vault",
            "visible": "always"
          },
          { "label": "Base units, with fee", "format": "raw", "path": "#.assets", "visible": "always" },
          { "label": "Native to deposit", "format": "amount", "path": "@.value", "visible": { "ifNotIn": ["0"] } },
          {
            "label": "Referral fee",
            "format": "unit",
            "params": { "base": "%", "decimals": 16 },
            "path": "#.referralFeePct",
            "visible": "always"
          },
          {
            "label": "Fee recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"] },
            "path": "#.referralFeeRecipient",
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "label": "Deadline",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "path": "#.deadline",
            "visible": { "ifNotIn": ["115792089237316195423570985008687907853269984665640564039457584007913129639935"] }
          },
          { "label": "Max share price", "path": "#.maxSharePriceE27", "visible": "never" },
          { "label": "Asset permit", "path": "#.assetPermit", "visible": "never" }
        ]
      },
      "vaultBundlesV1Withdraw(address vault, uint256 assets, uint256 shares, (uint256 value, uint256 nonce, uint256 deadline, uint8 v, bytes32 r, bytes32 s) sharesPermit, uint256 referralFeePct, address referralFeeRecipient, uint256 deadline)": {
        "intent": "Withdraw from vault",
        "fields": [
          {
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["contract", "token"] },
            "path": "#.vault",
            "visible": "always"
          },
          { "label": "Amount (base units)", "format": "raw", "path": "#.assets", "visible": { "ifNotIn": ["0"] } },
          {
            "label": "Shares to redeem",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.vault" },
            "path": "#.shares",
            "visible": { "ifNotIn": ["0"] }
          },
          {
            "label": "Referral fee",
            "format": "unit",
            "params": { "base": "%", "decimals": 16 },
            "path": "#.referralFeePct",
            "visible": { "ifNotIn": ["0"] }
          },
          {
            "label": "Fee recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"] },
            "path": "#.referralFeeRecipient",
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "label": "Deadline",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "path": "#.deadline",
            "visible": { "ifNotIn": ["115792089237316195423570985008687907853269984665640564039457584007913129639935"] }
          },
          { "label": "Shares permit", "path": "#.sharesPermit", "visible": "never" }
        ]
      },
      "vaultBundlesV1Migrate(address sourceVault, address destVault, uint256 assetsWithdrawn, uint256 sharesRedeemed, uint256 destMaxSharePriceE27, (uint256 value, uint256 nonce, uint256 deadline, uint8 v, bytes32 r, bytes32 s) sharesPermit, uint256 referralFeePct, address referralFeeRecipient, uint256 deadline)": {
        "intent": "Move to another vault",
        "interpolatedIntent": "Move to another vault with {#.referralFeePct} referral fee",
        "fields": [
          {
            "label": "From vault",
            "format": "addressName",
            "params": { "types": ["contract", "token"] },
            "path": "#.sourceVault",
            "visible": "always"
          },
          {
            "label": "To vault",
            "format": "addressName",
            "params": { "types": ["contract", "token"] },
            "path": "#.destVault",
            "visible": "always"
          },
          { "label": "Base units, with fee", "format": "raw", "path": "#.assetsWithdrawn", "visible": { "ifNotIn": ["0"] } },
          {
            "label": "Shares to move",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.sourceVault" },
            "path": "#.sharesRedeemed",
            "visible": { "ifNotIn": ["0"] }
          },
          {
            "label": "Referral fee",
            "format": "unit",
            "params": { "base": "%", "decimals": 16 },
            "path": "#.referralFeePct",
            "visible": "always"
          },
          {
            "label": "Fee recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet", "contract"] },
            "path": "#.referralFeeRecipient",
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "label": "Deadline",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "path": "#.deadline",
            "visible": { "ifNotIn": ["115792089237316195423570985008687907853269984665640564039457584007913129639935"] }
          },
          { "label": "Max share price", "path": "#.destMaxSharePriceE27", "visible": "never" },
          { "label": "Shares permit", "path": "#.sharesPermit", "visible": "never" }
        ]
      }
