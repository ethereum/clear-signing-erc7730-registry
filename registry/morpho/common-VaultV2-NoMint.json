{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "metadata": {
    "constants": {}
  },
  "display": {
    "formats": {
      "deposit(uint256 assets, address onBehalf)": {
        "intent": "Deposit",
        "fields": [
          {
            "path": "assets",
            "label": "Deposit asset",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.underlyingToken"
            },
            "visible": "always"
          },
          {
            "label": "Share ticker",
            "format": "raw",
            "value": "$.metadata.constants.vaultTicker"
          },
          {
            "path": "onBehalf",
            "label": "Send shares to",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          }
        ],
        "interpolatedIntent": "Deposit {#.assets} for {#.onBehalf}"
      },
      "withdraw(uint256 assets, address receiver, address onBehalf)": {
        "intent": "Withdraw",
        "fields": [
          {
            "path": "assets",
            "label": "Withdraw exactly",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.underlyingToken"
            },
            "visible": "always"
          },
          {
            "path": "receiver",
            "label": "To",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          },
          {
            "path": "onBehalf",
            "label": "Owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          }
        ],
        "interpolatedIntent": "Withdraw {#.assets} to {#.receiver}"
      },
      "redeem(uint256 shares, address receiver, address onBehalf)": {
        "intent": "Redeem",
        "fields": [
          {
            "path": "shares",
            "label": "Shares to redeem",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            },
            "visible": "always"
          },
          {
            "path": "receiver",
            "label": "To",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          },
          {
            "path": "onBehalf",
            "label": "Owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          }
        ],
        "interpolatedIntent": "Redeem {#.shares} to {#.receiver}"
      }
    }
  }
}
