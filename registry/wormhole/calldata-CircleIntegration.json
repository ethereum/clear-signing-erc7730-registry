{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "WormholeCircleIntegration",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0xAaDA05BD399372f0b0463744C09113c137636f6a" },
        { "chainId": 42161, "address": "0x2703483B1a5a7c577e8680de9Df8Be03c6f30e3c" },
        { "chainId": 43114, "address": "0x09Fb06A271faFf70A651047395AaEb6265265F13" },
        { "chainId": 8453, "address": "0x03faBB06Fa052557143dC28eFCFc63FC12843f1D" },
        { "chainId": 10, "address": "0x2703483B1a5a7c577e8680de9Df8Be03c6f30e3c" },
        { "chainId": 137, "address": "0x0FF28217dCc90372345954563486528aa865cDd6" }
      ]
    }
  },
  "metadata": {
    "owner": "Wormhole",
    "contractName": "CircleIntegration",
    "info": { "url": "https://portalbridge.com/" },
    "enums": {
      "wormholeChain": {
        "2": "Ethereum",
        "5": "Polygon",
        "6": "Avalanche",
        "23": "Arbitrum",
        "24": "Optimism",
        "30": "Base"
      }
    }
  },
  "display": {
    "formats": {
      "transferTokensWithPayload((address token,uint256 amount,uint16 targetChain,bytes32 mintRecipient) transferParams,uint32 batchId,bytes payload)": {
        "intent": "Bridge native USDC via CCTP",
        "fields": [
          { "path": "@.value", "label": "Wormhole fee", "format": "amount" },
          { "path": "#.transferParams.token", "label": "Token", "format": "addressName", "params": { "types": ["token", "contract"], "sources": ["local"] } },
          { "path": "#.transferParams.amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "#.transferParams.token" } },
          { "path": "#.transferParams.targetChain", "label": "Destination chain", "format": "enum", "params": { "$ref": "$.metadata.enums.wormholeChain" } },
          { "path": "#.transferParams.mintRecipient", "label": "Mint recipient (bytes32)", "format": "raw" },
          { "path": "#.payload", "label": "Payload", "format": "raw" },
          { "path": "#.batchId", "label": "Batch ID", "visible": "never" }
        ]
      },
      "redeemTokensWithPayload((bytes encodedWormholeMessage,bytes circleBridgeMessage,bytes circleAttestation) params)": {
        "intent": "Redeem USDC via Wormhole CCTP",
        "fields": [
          { "path": "#.params", "label": "Attestation", "visible": "never" }
        ]
      },
      "upgradeContract(bytes encodedMessage)": {
        "intent": "Upgrade Circle Integration",
        "fields": [
          { "path": "#.encodedMessage", "label": "Governance message", "visible": "never" }
        ]
      },
      "updateWormholeFinality(bytes encodedMessage)": {
        "intent": "Update Wormhole finality",
        "fields": [
          { "path": "#.encodedMessage", "label": "Governance message", "visible": "never" }
        ]
      },
      "registerEmitterAndDomain(bytes encodedMessage)": {
        "intent": "Register emitter and domain",
        "fields": [
          { "path": "#.encodedMessage", "label": "Governance message", "visible": "never" }
        ]
      },
      "initialize()": {
        "intent": "Initialize Circle Integration",
        "fields": []
      }
    }
  }
}
