{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 1, "address": "0xD37BbE5744D730a1d98d8DC97c42F0Ca46aD7146" }] } },
  "metadata": { "owner": "THORChain", "contractName": "THORChain Router", "info": { "url": "https://thorchain.org" } },
  "display": {
    "formats": {
      "deposit(address vault,address asset,uint256 amount,string memo)": {
        "intent": "Deposit to THORChain",
        "fields": [
          { "path": "@.value", "label": "ETH Sent", "format": "amount" },
          {
            "path": "amount",
            "label": "Amount (if token)",
            "format": "tokenAmount",
            "params": { "tokenPath": "asset", "nativeCurrencyAddress": ["0x0000000000000000000000000000000000000000"] }
          },
          { "path": "vault", "label": "Vault", "format": "addressName", "params": { "types": ["eoa"] } },
          { "path": "memo", "label": "THORChain Memo", "format": "raw" },
          { "path": "asset", "label": "Asset", "visible": "never" }
        ]
      },
      "depositWithExpiry(address vault,address asset,uint256 amount,string memo,uint256 expiration)": {
        "intent": "Deposit to THORChain",
        "fields": [
          { "path": "@.value", "label": "ETH Sent", "format": "amount" },
          {
            "path": "amount",
            "label": "Amount (if token)",
            "format": "tokenAmount",
            "params": { "tokenPath": "asset", "nativeCurrencyAddress": ["0x0000000000000000000000000000000000000000"] }
          },
          { "path": "vault", "label": "Vault", "format": "addressName", "params": { "types": ["eoa"] } },
          { "path": "memo", "label": "THORChain Memo", "format": "raw" },
          { "path": "expiration", "label": "Expires", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "asset", "label": "Asset", "visible": "never" }
        ]
      }
    }
  }
}
