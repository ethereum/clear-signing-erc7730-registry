  "display": {
    "formats": {
      "deposit(uint256 assets,address receiver)": {
        "intent": "Deposit into vault",
        "interpolatedIntent": "Deposit {assets} for {receiver}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.assets",
            "label": "Deposit amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.underlyingToken" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Share recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "mint(uint256 shares,address receiver)": {
        "intent": "Mint vault shares",
        "interpolatedIntent": "Mint {shares} for {receiver}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "value": "$.metadata.constants.underlyingTicker", "label": "Pays in (amount set by share price)", "format": "raw", "visible": "always" },
          {
            "path": "#.shares",
            "label": "Shares to mint",
            "format": "tokenAmount",
            "params": { "tokenPath": "@.to" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Share recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "withdraw(uint256 assets,address receiver,address owner)": {
        "intent": "Withdraw from vault",
        "interpolatedIntent": "Withdraw {assets} to {receiver} from {owner}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
