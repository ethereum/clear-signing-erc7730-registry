{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Symbiotic Vault V2 USDC",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x007e0B8E99c6134E81A1eAAE754460E3202cB671" },
        { "chainId": 1, "address": "0x4f7EA018239FfBdCf52133B9E98a498B2B4b9F32" },
        { "chainId": 1, "address": "0x56097f1a378848A51F35e7D9Ca2592c444EC4637" },
        { "chainId": 1, "address": "0x8BcD746976885b5832bAD07B4921E3f2dD1D3703" },
        { "chainId": 1, "address": "0x9902420048aEC155f1f1DF077f115595530Df216" },
        { "chainId": 1, "address": "0x9C8F48faD950D078AF0C6256Cb41e23B7185d142" },
        { "chainId": 1, "address": "0xCed027AdBF0966447b25E16f943A10780D5D1c08" }
      ]
    }
  },
  "metadata": {
    "owner": "Symbiotic",
    "info": { "url": "https://symbiotic.fi" },
    "contractName": "Vault V2 (USDC)",
    "constants": { "underlyingToken": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", "underlyingTicker": "USDC" }
  },
  "display": {
    "formats": {
      "deposit(uint256 assets,address receiver)": {
        "intent": "Deposit into vault",
        "interpolatedIntent": "Deposit {assets}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.assets",
            "label": "Deposit amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.underlyingToken" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Share recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "mint(uint256 shares,address receiver)": {
        "intent": "Mint vault shares",
        "interpolatedIntent": "Mint {shares} for {receiver}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "value": "$.metadata.constants.underlyingTicker", "label": "Deposit asset", "format": "raw", "visible": "always" },
          {
            "path": "#.shares",
            "label": "Shares to mint",
            "format": "tokenAmount",
            "params": { "tokenPath": "@.to" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Share recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "withdraw(uint256 assets,address receiver,address owner)": {
        "intent": "Withdraw from vault",
        "interpolatedIntent": "Withdraw {assets}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.assets",
            "label": "Assets to withdraw",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.underlyingToken" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.owner",
            "label": "Share owner",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "redeem(uint256 shares,address receiver,address owner)": {
        "intent": "Redeem vault shares",
        "interpolatedIntent": "Redeem {shares} to {receiver}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.shares",
            "label": "Shares to redeem",
            "format": "tokenAmount",
            "params": { "tokenPath": "@.to" },
            "visible": "always"
          },
          {
            "path": "#.receiver",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.owner",
            "label": "Share owner",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "approve(address spender,uint256 value)": {
        "intent": "Approve vault share spending",
        "interpolatedIntent": "Approve {value} for {spender}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.spender",
            "label": "Spender",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.value",
            "label": "Allowance amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to",
              "threshold": "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
              "message": "Unlimited"
            },
            "visible": "always"
          }
        ]
      },
      "permit(address owner,address spender,uint256 value,uint256 deadline,uint8 v,bytes32 r,bytes32 s)": {
        "intent": "Submit share permit",
        "interpolatedIntent": "Approve {value} for {spender}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.owner",
            "label": "Share owner",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.spender",
            "label": "Spender",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "#.value",
            "label": "Allowance amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to",
              "threshold": "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
              "message": "Unlimited"
            },
            "visible": "always"
          },
          {
            "path": "#.deadline",
            "label": "Signature deadline",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "visible": "always"
          },
          { "path": "#.v", "label": "Signature V", "format": "raw", "visible": "never" },
          { "path": "#.r", "label": "Signature R", "format": "raw", "visible": "never" },
          { "path": "#.s", "label": "Signature S", "format": "raw", "visible": "never" }
        ]
      }
    }
  }
}
