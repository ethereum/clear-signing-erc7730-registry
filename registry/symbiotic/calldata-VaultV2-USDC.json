  "metadata": {
    "owner": "Symbiotic",
    "info": { "url": "https://symbiotic.fi" },
    "contractName": "Vault V2 (USDC)",
    "constants": { "underlyingToken": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", "underlyingTicker": "USDC" },
    "enums": {
      "enabled": {
        "true": "Enabled",
        "false": "Disabled"
      },
      "membership": {
        "true": "Included",
        "false": "Excluded"
      },
      "roles": {
        "0": "Default admin",
        "53272272816779528707459608208793296754316034522596392027706107405367192656833": "Set management fee",
        "56709867117079014213459633094449057342148744007468143801194853692611130034289": "Set performance fee",
        "33646591496978789516124201366904265491527978862966175140283226066679055749683": "Set deposit limit",
        "70714254001513485140625174262889091090605462421923160261050180333758750825990": "Update depositor whitelist",
        "89859507824809856342377754349439363598024123081033812852694097080026424381356": "Enable deposit limit",
        "84534675251748009717328032765453215838473892888982269672368955310872597872675": "Enable deposit whitelist"
