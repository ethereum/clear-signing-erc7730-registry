{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "includes": "common-VaultV1.json",
  "context": {
    "contract": {}
  },
  "display": {
    "formats": {
      "redeem(address claimer,uint256 shares)": {
        "intent": "Queue share withdrawal",
        "interpolatedIntent": "Queue {shares} for {claimer}",
        "fields": [
          {
            "path": "@.to",
            "label": "Vault",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          },
          {
            "path": "#.shares",
            "label": "Vault shares",
            "format": "tokenAmount",
            "visible": "always",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "#.claimer",
            "label": "Claim owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          }
        ]
      }
    }
  }
}
