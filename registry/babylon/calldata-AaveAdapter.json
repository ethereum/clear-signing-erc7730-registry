{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "AaveAdapter",
    "contract": {
      "deployments": [{ "chainId": 1, "address": "0xadca531564f3B26d0aAF48a044d741fD6cD571Ea" }]
    }
  },
  "metadata": {
    "owner": "Babylon Labs",
    "info": { "url": "https://babylonlabs.io" },
    "enums": {
      "debtReserve": {
        "1": "USDT on Babylon Hub",
        "2": "USDC on Babylon Hub",
        "3": "GHO on Babylon Hub",
        "4": "WBTC on Babylon Hub",
        "5": "USDT on Core Hub",
        "6": "USDC on Core Hub",
        "7": "GHO on Core Hub",
        "8": "USDG on Core Hub",
        "9": "RLUSD on Core Hub"
      }
    },
    "contractName": "AaveAdapter"
  },
  "display": {
    "formats": {
      "borrowFromCorePosition(uint256 debtReserveId,uint256 amount,address receiver)": {
        "$id": "borrowFromCorePosition",
        "intent": "Borrow",
        "fields": [
          {
            "path": "debtReserveId",
            "label": "Asset",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.debtReserve" },
            "visible": "always"
          },
          { "path": "amount", "label": "Amount (base units)", "format": "raw", "visible": "always" },
          {
            "path": "receiver",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "repayToCorePosition(address borrower,uint256 debtReserveId,uint256 amount)": {
        "$id": "repayToCorePosition",
        "intent": "Repay",
        "fields": [
          {
            "path": "debtReserveId",
            "label": "Asset",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.debtReserve" },
            "visible": "always"
          },
          { "path": "amount", "label": "Max repay base units", "format": "raw", "visible": "always" },
          {
            "path": "borrower",
            "label": "Borrower",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          }
        ]
      },
      "withdrawCollaterals(bytes32[] vaultsToWithdraw)": {
        "$id": "withdrawCollaterals",
        "intent": "Withdraw BTC vaults",
        "fields": [{ "path": "vaultsToWithdraw.[]", "label": "Vault ID", "format": "raw", "visible": "always" }]
      },
      "reorderVaults(bytes32[] permuted)": {
        "$id": "reorderVaults",
        "intent": "Reorder BTC vaults",
        "fields": [{ "path": "permuted.[]", "label": "Vault ID", "format": "raw", "visible": "always" }]
      }
    }
  }
}
