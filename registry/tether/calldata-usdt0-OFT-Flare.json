{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "USDT0-OFT-Flare",
    "contract": { "deployments": [{ "chainId": 14, "address": "0x567287d2A9829215a37e3B88843d32f9221E7588" }] }
  },
  "metadata": {
    "owner": "Tether Limited",
    "info": { "url": "https://tether.to/" },
    "contractName": "USDT0-OFT-Flare",
    "constants": { "usdt0": "0xe7cd86e13AC4309349F30B3435a9d337750fC82D" }
  },
  "display": {
    "formats": {
      "send((uint32 dstEid, bytes32 to, uint256 amountLD, uint256 minAmountLD, bytes extraOptions, bytes composeMsg, bytes oftCmd) _sendParam, (uint256 nativeFee, uint256 lzTokenFee) _fee, address _refundAddress)": {
        "intent": "Bridge USDT0",
        "fields": [
          {
            "path": "#._sendParam.amountLD",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.usdt0" },
            "visible": "always"
          },
          {
            "path": "#._sendParam.minAmountLD",
            "label": "Minimum to receive",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.usdt0" },
            "visible": "always"
          },
          { "path": "#._sendParam.dstEid", "label": "Destination EID", "format": "raw", "visible": "always" },
          { "path": "#._sendParam.to", "label": "Recipient", "format": "raw", "visible": "always" },
          { "path": "#._fee.nativeFee", "label": "Bridge fee", "format": "amount", "visible": "always" },
          {
            "path": "#._refundAddress",
            "label": "Refund to",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "label": "Extra options", "path": "#._sendParam.extraOptions", "visible": "never" },
          { "label": "Compose message", "path": "#._sendParam.composeMsg", "visible": "never" },
          { "label": "OFT command", "path": "#._sendParam.oftCmd", "visible": "never" },
          { "label": "LZ token fee", "path": "#._fee.lzTokenFee", "visible": "never" }
        ]
      }
    }
  }
}
