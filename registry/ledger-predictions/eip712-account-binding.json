{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "eip712": {
      "deployments": [{ "chainId": 137, "address": "0x0000000000000000000000000000000000000000" }],
      "domain": { "name": "Ledger Predictions", "version": "1" }
    }
  },
  "metadata": { "owner": "Ledger", "info": { "url": "https://www.ledger.com" } },
  "display": {
    "formats": {
      "ConfirmAccountOwnership(string action,address account,string notice)": {
        "intent": "Confirm account ownership",
        "fields": [
          { "path": "account", "label": "Account", "format": "raw", "visible": "always" },
          { "path": "notice", "label": "Notice", "format": "raw", "visible": "always" },
          { "path": "action", "label": "Action", "format": "raw", "visible": { "mustMatch": ["Confirm account ownership"] } }
        ]
      }
    }
  }
}
