{
  "$schema": "../../../specs/erc7730-tests-v2.schema.json",
  "descriptor": "../eip712-account-binding.json",
  "dataProvider": { "tokens": {} },
  "tests": [
    {
      "description": "Confirm account ownership on chain 137 #1",
      "data": {
        "domain": {
          "name": "Ledger Predictions",
          "version": "1",
          "chainId": 137,
          "verifyingContract": "0x0000000000000000000000000000000000000000"
        },
        "types": {
          "EIP712Domain": [
            { "name": "name", "type": "string" },
            { "name": "version", "type": "string" },
            { "name": "chainId", "type": "uint256" },
            { "name": "verifyingContract", "type": "address" }
          ],
          "ConfirmAccountOwnership": [{ "name": "action", "type": "string" }, { "name": "account", "type": "address" }, { "name": "notice", "type": "string" }]
        },
        "primaryType": "ConfirmAccountOwnership",
        "message": {
          "action": "Confirm account ownership",
          "account": "0x110cdBba7FE6434Ec4CE3464CC523942ad6Fb784",
          "notice": "MoonPay Trade will operate a trading wallet for this account. Every trade and withdrawal needs your signature."
        }
      },
      "expected": {
        "intent": "Confirm account ownership",
        "owner": "Ledger",
        "fields": [
          { "label": "Account", "value": "0x110cdBba7FE6434Ec4CE3464CC523942ad6Fb784" },
          {
            "label": "Notice",
            "value": "MoonPay Trade will operate a trading wallet for this account. Every trade and withdrawal needs your signature."
          }
        ]
      }
    }
  ]
}
