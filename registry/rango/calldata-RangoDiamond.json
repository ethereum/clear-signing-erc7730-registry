{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "RangoDiamond",
    "contract": { "deployments": [{ "chainId": 137, "address": "0x69460570c93f9DE5E2edbC3052bf10125f0Ca22d" }] }
  },
  "metadata": {
    "owner": "Rango Exchange",
    "contractName": "RangoDiamond",
    "info": { "url": "https://rango.exchange" },
    "constants": { "nativeToken": "0x0000000000000000000000000000000000000000" }
  },
  "display": {
    "formats": {
      "genericBridge((uint8 bridgeId,(address target,address spender,bytes data,uint256 startIndexForAmount,uint256 nativeValueToSend,bool valueIsBridgeAmount)[] calls,address recipient,uint256 dstChainId,bool hasInterchainMessage,bool hasDestinationSwap,uint256 extraFee,uint256 extraERC20Fee) bridgeRequest,(address requestId,address token,uint256 amount,(address affiliatorAddress,uint256 amount,uint8 feeType)[] affiliateFees,uint256 totalAffiliateFee,uint16 dAppTag,string dAppName) request)": {
        "$id": "genericBridge",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {#.request.amount} to {#.bridgeRequest.dstChainId}",
        "fields": [
          {
            "path": "#.request.amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.request.token", "nativeCurrencyAddress": "$.metadata.constants.nativeToken" },
            "visible": "always"
          },
          {
            "path": "#.request.totalAffiliateFee",
            "label": "Fee",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.request.token", "nativeCurrencyAddress": "$.metadata.constants.nativeToken" },
            "visible": "always"
          },
          { "path": "#.bridgeRequest.dstChainId", "label": "Dest. chain id", "format": "raw", "visible": "always" },
          {
            "path": "#.bridgeRequest.recipient",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["wallet", "eoa", "contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "@.value", "label": "Native value", "format": "amount", "visible": "always" },
          { "path": "#.bridgeRequest.bridgeId", "label": "Bridge ID", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].target", "label": "Call target", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].spender", "label": "Call spender", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].data", "label": "Call data", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].startIndexForAmount", "label": "Amount index", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].nativeValueToSend", "label": "Call value", "visible": "never" },
          { "path": "#.bridgeRequest.calls.[].valueIsBridgeAmount", "label": "Value is amt", "visible": "never" },
          { "path": "#.bridgeRequest.hasInterchainMessage", "label": "Has message", "visible": "never" },
          { "path": "#.bridgeRequest.hasDestinationSwap", "label": "Has dest. swap", "visible": "never" },
          { "path": "#.bridgeRequest.extraFee", "label": "Extra fee", "visible": "never" },
          { "path": "#.bridgeRequest.extraERC20Fee", "label": "Extra tkn fee", "visible": "never" },
          { "path": "#.request.requestId", "label": "Request ID", "visible": "never" },
          { "path": "#.request.affiliateFees.[].affiliatorAddress", "label": "Fee recipient", "visible": "never" },
          { "path": "#.request.affiliateFees.[].amount", "label": "Fee part", "visible": "never" },
          { "path": "#.request.affiliateFees.[].feeType", "label": "Fee type", "visible": "never" },
          { "path": "#.request.dAppTag", "label": "dApp tag", "visible": "never" },
          { "path": "#.request.dAppName", "label": "dApp name", "visible": "never" }
        ]
      }
    }
  }
}
