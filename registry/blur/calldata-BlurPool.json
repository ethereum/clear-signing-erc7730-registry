{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Blur Pool",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x0000000000A39bb272e79075ade125fd351887Ac" }] }
  },
  "metadata": { "owner": "Blur", "contractName": "Blur Pool", "info": { "url": "https://blur.io/" } },
  "display": {
    "formats": {
      "deposit()": {
        "intent": "Add to Blur Pool",
        "interpolatedIntent": "Add {@.value} to your Blur Pool balance",
        "fields": [{ "path": "@.value", "label": "Amount", "format": "amount" }]
      },
      "withdraw(uint256 amount)": {
        "intent": "Withdraw from Blur Pool",
        "interpolatedIntent": "Withdraw {amount} from your Blur Pool balance",
        "fields": [{ "path": "amount", "label": "Amount", "format": "amount" }]
      }
    }
  }
}
