{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "TransferEOALegacyRouter",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x4E81E1Ed3F6684EB948F8956b8787967b1a6275b" }] }
  },
  "metadata": {
    "owner": "10102",
    "info": { "url": "https://10102.io" },
    "contractName": "TransferEOALegacyRouter",
    "enums": { "layer": { "2": "First backup", "3": "Second backup" }, "backupShare": { "0": "None", "1000000": "100%" } }
  },
  "display": {
    "formats": {
      "createLegacyV2((address user, uint256 percent)[] distributions_, (uint256 lackOfOutgoingTxRange, uint256 delayLayer2, uint256 delayLayer3) extraConfig_, (address user, uint256 percent) layer2Distribution_, (address user, uint256 percent) layer3Distribution_, (((address token, uint160 amount, uint48 expiration, uint48 nonce)[] details, address spender, uint256 sigDeadline) permitBatch, bytes signature) permit2_, uint256 signatureTimestamp, bytes agreementSignature)": {
        "$id": "createLegacyV2",
        "intent": "Create legacy, approve tokens",
        "fields": [
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "distributions_.[].user",
                "label": "Beneficiary",
                "format": "addressName",
                "params": { "sources": ["local", "ens"] }
              },
              { "path": "distributions_.[].percent", "label": "Share", "format": "unit", "params": { "base": "%", "decimals": 4 } }
            ]
          },
          { "path": "distributions_.[]", "label": "Beneficiaries", "visible": "never" },
          { "path": "extraConfig_.lackOfOutgoingTxRange", "label": "Inactivity period", "format": "duration" },
          {
            "path": "layer2Distribution_.user",
            "label": "Backup beneficiary",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] },
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "path": "layer2Distribution_.percent",
            "label": "Backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "extraConfig_.delayLayer2", "label": "Backup delay", "format": "duration", "visible": { "ifNotIn": [0] } },
          {
            "path": "layer3Distribution_.user",
            "label": "Second backup",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] },
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "path": "layer3Distribution_.percent",
            "label": "Second backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "extraConfig_.delayLayer3", "label": "Second backup delay", "format": "duration", "visible": { "ifNotIn": [0] } },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "permit2_.permitBatch.details.[].token",
                "label": "Token covered",
                "format": "addressName",
                "params": { "types": ["token"], "sources": ["local"] }
              },
              {
                "path": "permit2_.permitBatch.details.[].amount",
                "label": "Amount covered",
                "format": "tokenAmount",
                "params": {
                  "tokenPath": "permit2_.permitBatch.details.[].token",
                  "threshold": "0xffffffffffffffffffffffffffffffffffffffff",
                  "message": "Unlimited"
                }
              },
              {
                "path": "permit2_.permitBatch.details.[].expiration",
                "label": "Permission expires",
                "format": "date",
                "params": { "encoding": "timestamp" }
              }
            ]
          },
          {
            "path": "permit2_.permitBatch.spender",
            "label": "Permission held by",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local"] }
          },
          { "path": "permit2_.permitBatch.details.[].nonce", "label": "Permit nonce", "visible": "never" },
          { "path": "permit2_.permitBatch.details.[]", "label": "Permit details", "visible": "never" },
          { "path": "permit2_.permitBatch.sigDeadline", "label": "Permit deadline", "visible": "never" },
          { "path": "permit2_.signature", "label": "Permit signature", "visible": "never" },
          { "path": "signatureTimestamp", "label": "Terms timestamp", "visible": "never" },
          { "path": "agreementSignature", "label": "Terms signature", "visible": "never" }
        ]
      },
      "avtiveAlive(uint256 legacyId_)": {
        "$id": "avtiveAlive",
        "intent": "Check in",
        "interpolatedIntent": "Check in on legacy {legacyId_}",
        "fields": [{ "path": "legacyId_", "label": "Legacy", "format": "raw" }]
      },
      "setActivationTrigger(uint256 legacyId_, uint128 lackOfOutgoingTxRange_)": {
        "$id": "setActivationTrigger",
        "intent": "Change inactivity period",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          { "path": "lackOfOutgoingTxRange_", "label": "Inactivity period", "format": "duration" }
        ]
      },
      "setLegacyDistributions(uint256 legacyId_, string[] nickNames_, (address user, uint256 percent)[] distributions_)": {
        "$id": "setLegacyDistributions",
        "intent": "Change beneficiaries",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "distributions_.[].user",
                "label": "Beneficiary",
                "format": "addressName",
                "params": { "sources": ["local", "ens"] }
              },
              { "path": "distributions_.[].percent", "label": "Share", "format": "unit", "params": { "base": "%", "decimals": 4 } }
            ]
          },
          { "path": "distributions_.[]", "label": "Beneficiaries", "visible": "never" },
          { "path": "nickNames_", "label": "Nicknames (ignored)", "visible": "never" }
        ]
      },
      "setLayer23Distributions(uint256 legacyId_, uint8 layer_, string nickname_, (address user, uint256 percent) distribution_)": {
        "$id": "setLayer23Distributions",
        "intent": "Change backup beneficiary",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          { "path": "layer_", "label": "Backup", "format": "enum", "params": { "$ref": "$.metadata.enums.layer" } },
          {
            "path": "distribution_.user",
            "label": "Backup beneficiary",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] }
          },
          {
            "path": "distribution_.percent",
            "label": "Backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "nickname_", "label": "Nickname (ignored)", "visible": "never" }
        ]
      },
      "setBothLayer23Distributions(uint256 legacyId_, string layer2Nickname_, (address user, uint256 percent) layer2Distribution_, string layer3Nickname_, (address user, uint256 percent) layer3Distribution_)": {
        "$id": "setBothLayer23Distributions",
        "intent": "Change backup beneficiaries",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          {
            "path": "layer2Distribution_.user",
            "label": "Backup beneficiary",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] }
          },
          {
            "path": "layer2Distribution_.percent",
            "label": "Backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          {
            "path": "layer3Distribution_.user",
            "label": "Second backup",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] }
          },
          {
            "path": "layer3Distribution_.percent",
            "label": "Second backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "layer2Nickname_", "label": "Nickname 2", "visible": "never" },
          { "path": "layer3Nickname_", "label": "Nickname 3", "visible": "never" }
        ]
      },
      "setLegacyConfig(uint256 legacyId_, (string name, string note, string[] nickNames, (address user, uint256 percent)[] distributions) mainConfig_, (uint256 lackOfOutgoingTxRange, uint256 delayLayer2, uint256 delayLayer3) extraConfig_, (address user, uint256 percent) layer2Distribution_, (address user, uint256 percent) layer3Distribution_, string layer2Nickname_, string layer3Nickname_)": {
        "$id": "setLegacyConfig",
        "intent": "Update legacy",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "mainConfig_.distributions.[].user",
                "label": "Beneficiary",
                "format": "addressName",
                "params": { "sources": ["local", "ens"] }
              },
              {
                "path": "mainConfig_.distributions.[].percent",
                "label": "Share",
                "format": "unit",
                "params": { "base": "%", "decimals": 4 }
              }
            ]
          },
          { "path": "mainConfig_.distributions.[]", "label": "Beneficiaries", "visible": "never" },
          { "path": "extraConfig_.lackOfOutgoingTxRange", "label": "Inactivity period", "format": "duration" },
          {
            "path": "layer2Distribution_.user",
            "label": "Backup beneficiary",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] }
          },
          {
            "path": "layer2Distribution_.percent",
            "label": "Backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "extraConfig_.delayLayer2", "label": "Backup delay", "format": "duration", "visible": { "ifNotIn": [0] } },
          {
            "path": "layer3Distribution_.user",
            "label": "Second backup",
            "format": "addressName",
            "params": { "sources": ["local", "ens"] },
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "path": "layer3Distribution_.percent",
            "label": "Second backup share",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.backupShare" }
          },
          { "path": "extraConfig_.delayLayer3", "label": "Second backup delay", "format": "duration", "visible": { "ifNotIn": [0] } },
          { "path": "mainConfig_.name", "label": "Name", "visible": "never" },
          { "path": "mainConfig_.note", "label": "Note", "visible": "never" },
          { "path": "mainConfig_.nickNames", "label": "Nicknames", "visible": "never" },
          { "path": "layer2Nickname_", "label": "Nickname 2", "visible": "never" },
          { "path": "layer3Nickname_", "label": "Nickname 3", "visible": "never" }
        ]
      },
      "setAutoRenew(uint256 legacyId_, bool enabled_)": {
        "$id": "setAutoRenew",
        "intent": "Set automatic renewal",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          { "path": "enabled_", "label": "Automatic renewal on", "format": "raw" }
        ]
      },
      "setSponsoredClaimsEnabled(uint256 legacyId_, bool enabled_)": {
        "$id": "setSponsoredClaimsEnabled",
        "intent": "Set gas-free claims",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          { "path": "enabled_", "label": "Gas-free claims", "format": "raw" }
        ]
      },
      "autoSwap(uint256 legacyId_, (address storageToken, uint256 amountOutMin, uint256 deadline) swap_)": {
        "$id": "autoSwap",
        "intent": "Convert ETH to a token",
        "fields": [
          { "path": "@.value", "label": "ETH to convert", "format": "amount" },
          {
            "path": "swap_.storageToken",
            "label": "Token received",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] }
          },
          {
            "path": "swap_.amountOutMin",
            "label": "Swap min (not WETH)",
            "format": "tokenAmount",
            "params": { "tokenPath": "swap_.storageToken" }
          },
          { "path": "swap_.deadline", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "legacyId_", "label": "Legacy", "format": "raw" }
        ]
      },
      "unswap(uint256 legacyId_, uint256 amountIn_, uint256 amountOutMin_, uint256 deadline_)": {
        "$id": "unswap",
        "intent": "Convert back to ETH",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          { "path": "amountIn_", "label": "Token (base units)", "format": "raw" },
          { "path": "amountOutMin_", "label": "Minimum ETH received", "format": "amount" },
          { "path": "deadline_", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } }
        ]
      },
      "withdraw(uint256 legacyId_, uint256 amount_)": {
        "$id": "withdraw",
        "intent": "Withdraw ETH from legacy",
        "fields": [{ "path": "legacyId_", "label": "Legacy", "format": "raw" }, { "path": "amount_", "label": "Amount", "format": "amount" }]
      },
      "deleteLegacy(uint256 legacyId_)": {
        "$id": "deleteLegacy",
        "intent": "Delete legacy",
        "interpolatedIntent": "Delete legacy {legacyId_}",
        "fields": [{ "path": "legacyId_", "label": "Legacy", "format": "raw" }]
      },
      "activeLegacy(uint256 legacyId_, address[] assets_, bool isETH_)": {
        "$id": "activeLegacy",
        "intent": "Claim legacy",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          {
            "path": "assets_.[]",
            "label": "Token claimed",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] }
          },
          { "path": "isETH_", "label": "Include ETH", "format": "raw" }
        ]
      },
      "activeLegacyAndUnswap(uint256 legacyId_, address[] assets_, uint256 amountOutMin_, uint256 deadline_)": {
        "$id": "activeLegacyAndUnswap",
        "intent": "Claim legacy as ETH",
        "fields": [
          { "path": "legacyId_", "label": "Legacy", "format": "raw" },
          {
            "path": "assets_.[]",
            "label": "Token claimed",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] }
          },
          { "path": "amountOutMin_", "label": "Swap min (not WETH)", "format": "amount" },
          { "path": "deadline_", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } }
        ]
      }
    }
  }
}
