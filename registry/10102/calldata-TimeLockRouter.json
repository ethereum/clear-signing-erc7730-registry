          { "path": "timelockGift.timelockERC20.[].tokenAddress", "label": "Token address", "visible": "never" },
          { "path": "timelockGift.timelockERC20.[]", "label": "Tokens", "visible": "never" },
          { "path": "timelockGift.timelockERC721.[]", "label": "NFTs", "visible": "never" },
          { "path": "timelockGift.timelockERC1155.[]", "label": "Items", "visible": "never" },
          { "path": "timelockGift.name", "label": "Name", "visible": "never" },
          { "path": "timelockGift.giftName", "label": "Gift name", "visible": "never" }
