                "label": "NFT collection",
                "format": "addressName",
                "params": { "types": ["collection"], "sources": ["local"] }
              },
              {
                "path": "timelockGift.timelockERC721.[].id",
                "label": "NFT locked",
                "format": "nftName",
                "params": { "collectionPath": "timelockGift.timelockERC721.[].tokenAddress" }
              }
            ]
          },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "timelockGift.timelockERC1155.[].tokenAddress",
                "label": "Item collection",
                "format": "addressName",
                "params": { "types": ["collection"], "sources": ["local"] }
              },
              {
                "path": "timelockGift.timelockERC1155.[].id",
                "label": "Item locked",
                "format": "nftName",
                "params": { "collectionPath": "timelockGift.timelockERC1155.[].tokenAddress" }
