{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "TimeLockRouter",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x2B947E3c348c81409f8e8fc5ef8F65d9dFf76A42" }] }
  },
  "metadata": { "owner": "10102", "info": { "url": "https://10102.io" }, "contractName": "TimeLockRouter" },
  "display": {
    "formats": {
      "createTimelock(((address storageToken, uint256 amountOutMin, uint256 deadline) timelockETHSwap, (address tokenAddress, uint256 amount)[] timelockERC20, (address tokenAddress, uint256 id)[] timelockERC721, (address tokenAddress, uint256 id, uint256 amount)[] timelockERC1155, uint256 duration, string name) timelockRegular)": {
        "$id": "createTimelock",
        "intent": "Create timelock",
        "fields": [
          { "path": "@.value", "label": "ETH sent to lock", "format": "amount", "visible": { "ifNotIn": [0] } },
          {
            "path": "timelockRegular.timelockETHSwap.storageToken",
            "label": "ETH held as",
            "format": "addressName",
            "params": { "types": ["token"], "sources": ["local"] },
            "visible": { "ifNotIn": ["0x0000000000000000000000000000000000000000"] }
          },
          {
            "path": "timelockRegular.timelockETHSwap.amountOutMin",
            "label": "Swap min (not WETH)",
            "format": "tokenAmount",
            "params": { "tokenPath": "timelockRegular.timelockETHSwap.storageToken" },
            "visible": { "ifNotIn": [0] }
          },
          {
            "path": "timelockRegular.timelockETHSwap.deadline",
            "label": "Swap deadline",
            "format": "date",
            "params": { "encoding": "timestamp" },
            "visible": { "ifNotIn": [0] }
          },
          {
            "path": "timelockRegular.timelockERC20.[].amount",
            "label": "Token sent to lock",
            "format": "tokenAmount",
            "params": { "tokenPath": "timelockRegular.timelockERC20.[].tokenAddress" }
          },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "timelockRegular.timelockERC721.[].tokenAddress",
                "label": "NFT collection",
                "format": "addressName",
                "params": { "types": ["collection"], "sources": ["local"] }
              },
              {
                "path": "timelockRegular.timelockERC721.[].id",
                "label": "NFT locked",
                "format": "nftName",
                "params": { "collectionPath": "timelockRegular.timelockERC721.[].tokenAddress" }
              }
            ]
          },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "timelockRegular.timelockERC1155.[].tokenAddress",
                "label": "Item collection",
                "format": "addressName",
                "params": { "types": ["collection"], "sources": ["local"] }
              },
              {
                "path": "timelockRegular.timelockERC1155.[].id",
                "label": "Item locked",
                "format": "nftName",
                "params": { "collectionPath": "timelockRegular.timelockERC1155.[].tokenAddress" }
              },
              { "path": "timelockRegular.timelockERC1155.[].amount", "label": "Item quantity", "format": "raw" }
            ]
          },
          { "path": "timelockRegular.duration", "label": "Locked for", "format": "duration" },
          { "path": "timelockRegular.timelockERC20.[].tokenAddress", "label": "Token address", "visible": "never" },
          { "path": "timelockRegular.timelockERC20.[]", "label": "Tokens", "visible": "never" },
          { "path": "timelockRegular.timelockERC721.[]", "label": "NFTs", "visible": "never" },
          { "path": "timelockRegular.timelockERC1155.[]", "label": "Items", "visible": "never" },
          { "path": "timelockRegular.name", "label": "Name", "visible": "never" }
        ]
      },
