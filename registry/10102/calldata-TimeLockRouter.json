      "unlockSoftTimelock(uint256 id)": {
        "$id": "unlockSoftTimelock",
        "intent": "Start soft timelock countdown",
        "fields": [{ "path": "id", "label": "Timelock", "format": "raw" }]
      },
      "withdraw(uint256 id)": { "$id": "withdraw", "intent": "Withdraw from timelock", "fields": [{ "path": "id", "label": "Timelock", "format": "raw" }] },
      "withdraw(uint256 id, bool skipSwap)": {
        "$id": "withdraw",
        "intent": "Withdraw from timelock",
        "fields": [
          { "path": "id", "label": "Timelock", "format": "raw" },
          { "path": "skipSwap", "label": "Skip ETH conversion", "format": "raw" }
        ]
      }
