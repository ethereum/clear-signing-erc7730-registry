      "addLiquidity(address tokenA,address tokenB,uint256 amountADesired,uint256 amountBDesired,uint256 amountAMin,uint256 amountBMin,address to,uint256 deadline)": {
        "intent": "Add Liquidity",
        "fields": [
          { "path": "amountADesired", "label": "Maximum to Add", "format": "tokenAmount", "params": { "tokenPath": "tokenA" } },
          { "path": "amountBDesired", "label": "Maximum to Add", "format": "tokenAmount", "params": { "tokenPath": "tokenB" } },
          { "path": "amountAMin", "label": "Minimum to Add", "format": "tokenAmount", "params": { "tokenPath": "tokenA" } },
          { "path": "amountBMin", "label": "Minimum to Add", "format": "tokenAmount", "params": { "tokenPath": "tokenB" } },
          {
            "path": "to",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] }
          },
          { "path": "deadline", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "tokenA", "label": "Token A", "visible": "never" },
          { "path": "tokenB", "label": "Token B", "visible": "never" }
