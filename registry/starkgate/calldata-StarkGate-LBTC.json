{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "L1StarkGateLBTCBridge",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x96C8AE2AC9A5cd5fC354e375dB4d0ca75fc0685e"
        }
      ]
    }
  },
  "metadata": {
    "owner": "StarkWare",
    "info": {
      "url": "https://starkgate.starknet.io/",
      "deploymentDate": "2025-09-15T00:00:00Z"
    },
    "contractName": "L1StarkGateLBTCBridge"
  },
  "display": {
    "formats": {
      "deposit(address token, uint256 amount, uint256 l2Recipient)": {
        "$id": "deposit",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {amount} to {l2Recipient}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to deposit",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token"
            },
            "visible": "always"
          },
          {
            "path": "l2Recipient",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Deposit fee",
            "format": "amount"
          }
        ]
      },
      "depositWithMessage(address token, uint256 amount, uint256 l2Recipient, uint256[] message)": {
        "$id": "depositWithMessage",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {amount} to {l2Recipient}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to deposit",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token"
            },
            "visible": "always"
          },
          {
            "path": "l2Recipient",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "message.[]",
            "label": "Message",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Deposit fee",
            "format": "amount"
          }
        ]
      }
    }
  }
}
