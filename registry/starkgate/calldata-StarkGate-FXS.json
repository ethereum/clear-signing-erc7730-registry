{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "L1StarkGateFXSBridge",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x66ba83ba3D3AD296424a2258145d9910E9E40B7C"
        }
      ]
    }
  },
  "metadata": {
    "owner": "StarkWare",
    "info": {
      "url": "https://starkgate.starknet.io/",
      "deploymentDate": "2023-08-22T00:00:00Z"
    },
    "contractName": "L1StarkGateFXSBridge",
    "constants": {
      "tokenAddress": "0x3432B6A60D23Ca0dFCa7761B7ab56459D9C964D0"
    }
  },
  "display": {
    "formats": {
      "deposit(address token, uint256 amount, uint256 l2Recipient)": {
        "$id": "deposit",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {amount} to {l2Recipient}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to deposit",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token"
            },
            "visible": "always"
          },
          {
            "path": "l2Recipient",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Deposit fee",
            "format": "amount"
          }
        ]
      },
      "deposit(uint256 amount, uint256 l2Recipient)": {
        "$id": "depositLegacy",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {amount} to {l2Recipient}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to deposit",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.tokenAddress"
            },
            "visible": "always"
          },
          {
            "path": "l2Recipient",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Deposit fee",
            "format": "amount"
          }
        ]
      },
      "depositWithMessage(address token, uint256 amount, uint256 l2Recipient, uint256[] message)": {
        "$id": "depositWithMessage",
        "intent": "Bridge",
        "interpolatedIntent": "Bridge {amount} to {l2Recipient}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to deposit",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token"
            },
            "visible": "always"
          },
          {
            "path": "l2Recipient",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "message.[]",
            "label": "Message",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Deposit fee",
            "format": "amount"
          }
        ]
      }
    }
  }
}
