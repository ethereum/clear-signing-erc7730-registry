{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 1, "address": "0xD152f549545093347A162Dce210e7293f1452150" }] } },
  "metadata": { "owner": "Disperse", "contractName": "Disperse", "info": { "url": "https://disperse.app" } },
  "display": {
    "formats": {
      "disperseEther(address[] recipients,uint256[] values)": {
        "intent": "Send ETH to many",
        "fields": [
          { "path": "@.value", "label": "Maximum Total", "format": "amount" },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "recipients.[]",
                "label": "To",
                "format": "addressName",
                "separator": "Payment {index}",
                "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] }
              },
              { "path": "values.[]", "label": "Amount", "format": "amount" }
            ]
          }
        ],
        "interpolatedIntent": "Send up to {@.value} in total"
      },
      "disperseToken(address token,address[] recipients,uint256[] values)": {
        "intent": "Send tokens to many",
        "fields": [
          { "path": "token", "label": "Token", "format": "tokenTicker" },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "recipients.[]",
                "label": "To",
                "format": "addressName",
                "separator": "Payment {index}",
                "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] }
              },
              { "path": "values.[]", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "token" } }
            ]
          }
        ],
        "interpolatedIntent": "Send {token} to many"
      },
      "disperseTokenSimple(address token,address[] recipients,uint256[] values)": {
        "intent": "Send tokens to many",
        "fields": [
          { "path": "token", "label": "Token", "format": "tokenTicker" },
          {
            "iteration": "bundled",
            "fields": [
              {
                "path": "recipients.[]",
                "label": "To",
                "format": "addressName",
                "separator": "Payment {index}",
                "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] }
              },
              { "path": "values.[]", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "token" } }
            ]
          }
        ],
        "interpolatedIntent": "Send {token} to many"
      }
    }
  }
}
