{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0xE75D77B1865Ae93c7eaa3040B038D7aA7BC02F70"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Origin Protocol",
    "info": {
      "url": "https://www.originprotocol.com"
    },
    "constants": {
      "underlyingToken": "0x2a8e1e676ec238d8a992307b495b45b3feaa5e86",
      "redeemToken": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
    }
  },
  "display": {
    "formats": {
      "redeem(uint256 _amount, uint256 _minimumUnitAmount)": {
        "intent": "Redeem",
        "fields": [
          {
            "label": "Amount",
            "format": "tokenAmount",
            "path": "_amount",
            "params": {
              "token": "$.metadata.constants.underlyingToken"
            },
            "visible": "always"
          },
          {
            "label": "Minimum Received",
            "format": "tokenAmount",
            "path": "_minimumUnitAmount",
            "params": {
              "token": "$.metadata.constants.redeemToken"
            },
            "visible": "always"
          }
        ]
      }
    }
  }
}
