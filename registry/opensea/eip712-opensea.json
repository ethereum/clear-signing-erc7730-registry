            "params": { "$ref": "$.metadata.enums.saleKind" },
            "visible": "always"
          },
          {
            "path": "basePrice",
            "label": "Price",
            "format": "tokenAmount",
            "params": { "tokenPath": "paymentToken" },
            "visible": "always"
          },
          {
            "path": "maker",
            "label": "Maker",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] },
