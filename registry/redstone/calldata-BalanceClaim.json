{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Redstone Balance Claim",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x7CC324F1Fd4C0d5EEcBCdC66ca12cC07E80540c0" }] }
  },
  "metadata": { "owner": "Redstone", "contractName": "Redstone Balance Claim", "info": { "url": "https://redstone.xyz" } },
  "display": {
    "formats": {
      "claimBalance(address account,uint256 balance,bytes32[] proof)": {
        "intent": "Claim Redstone balance",
        "interpolatedIntent": "Claim the Redstone balance of {balance} on Ethereum to {account}",
        "fields": [
          { "path": "balance", "label": "Claimable balance", "format": "amount" },
          { "path": "account", "label": "Recipient", "format": "addressName", "params": { "types": ["eoa", "contract"] } },
          { "path": "proof", "label": "Merkle proof", "visible": "never" }
        ]
      }
    }
  }
}
