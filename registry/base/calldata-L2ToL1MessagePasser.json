{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 8453, "address": "0x4200000000000000000000000000000000000016" }] } },
  "metadata": { "owner": "Base", "contractName": "L2ToL1MessagePasser", "info": { "url": "https://base.org" } },
  "display": {
    "formats": {
      "burn()": { "intent": "Burn withdrawn ETH", "fields": [], "interpolatedIntent": "Burn ETH left by withdrawals" },
      "initiateWithdrawal(address _target,uint256 _gasLimit,bytes _data)": {
        "intent": "Start ETH withdrawal to Ethereum",
        "fields": [
          { "path": "@.value", "label": "ETH to Withdraw", "format": "amount" },
          { "path": "_target", "label": "L1 Recipient", "format": "addressName", "params": { "types": ["eoa", "contract"] } },
          { "path": "_gasLimit", "label": "Min L1 Gas", "format": "unit", "params": { "base": "gas" } },
          {
            "path": "_data",
            "label": "L1 Call",
            "format": "calldata",
            "params": { "calleePath": "_target", "chainId": 1, "amountPath": "@.value", "spender": "0x49048044D57e1C92A77f79988d21Fa8fAF74E97e" }
          }
        ],
        "interpolatedIntent": "Start withdrawal of {@.value} to {_target} on Ethereum"
      }
    }
  }
}
