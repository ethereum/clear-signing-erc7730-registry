{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ClaimSetupManager-Flare",
    "contract": {
      "deployments": [
        {
          "chainId": 14,
          "address": "0xD56c0Ea37B848939B59e6F5Cda119b3fA473b5eB"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Flare Foundation",
    "info": {
      "url": "https://flare.network/"
    },
    "contractName": "ClaimSetupManager-Flare"
  },
  "display": {
    "formats": {
      "setClaimExecutors(address[] _executors)": {
        "intent": "Set claim executors",
        "fields": [
          {
            "label": "Executors",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._executors.[]",
            "visible": "always"
          },
          {
            "label": "Max executor fees, excess refunded",
            "format": "amount",
            "path": "@.value",
            "visible": "always"
          }
        ]
      },
      "setAllowedClaimRecipients(address[] _recipients)": {
        "intent": "Set allowed claim recipients",
        "fields": [
          {
            "label": "Recipients",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._recipients.[]",
            "visible": "always"
          }
        ]
      },
      "setAutoClaiming(address[] _executors, bool _enableDelegationAccount)": {
        "intent": "Enable automatic claiming",
        "fields": [
          {
            "label": "Executors",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._executors.[]",
            "visible": "always"
          },
          {
            "label": "Delegation Account",
            "format": "raw",
            "path": "#._enableDelegationAccount",
            "visible": "always"
          },
          {
            "label": "Max executor fees, excess refunded",
            "format": "amount",
            "path": "@.value",
            "visible": "always"
          }
        ]
      },
      "enableDelegationAccount()": {
        "intent": "Enable delegation account",
        "fields": []
      },
      "disableDelegationAccount()": {
        "intent": "Disable delegation account, withdraw WFLR",
        "fields": []
      },
      "withdraw(uint256 _amount)": {
        "intent": "Withdraw funds",
        "fields": [
          {
            "label": "Amount",
            "format": "tokenAmount",
            "path": "#._amount",
            "visible": "always",
            "params": {
              "token": "0x1D80c49BbBCd1C0911346656B529DF9E5c2F783d"
            }
          }
        ]
      },
      "transferExternalToken(address _token, uint256 _amount)": {
        "intent": "Recover external token",
        "fields": [
          {
            "label": "Token",
            "format": "addressName",
            "params": {
              "types": [
                "token"
              ]
            },
            "path": "#._token",
            "visible": "always"
          },
          {
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "#._token"
            },
            "path": "#._amount",
            "visible": "always"
          }
        ]
      },
      "delegate(address _to, uint256 _bips)": {
        "intent": "Set FTSO delegation share",
        "fields": [
          {
            "label": "Provider",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "path": "#._to",
            "visible": "always"
          },
          {
            "label": "Share",
            "format": "unit",
            "params": {
              "decimals": 2,
              "base": "%"
            },
            "path": "#._bips",
            "visible": "always"
          }
        ]
      },
      "batchDelegate(address[] _delegatees, uint256[] _bips)": {
        "intent": "Replace all FTSO delegations",
        "fields": [
          {
            "iteration": "bundled",
            "fields": [
              {
                "label": "Provider",
                "format": "addressName",
                "params": {
                  "types": [
                    "eoa",
                    "contract"
                  ]
                },
                "path": "#._delegatees.[]",
                "visible": "always"
              },
              {
                "label": "Share",
                "format": "unit",
                "params": {
                  "decimals": 2,
                  "base": "%"
                },
                "path": "#._bips.[]",
                "visible": "always"
              }
            ]
          }
        ]
      },
      "undelegateAll()": {
        "intent": "Undelegate FTSO vote power",
        "fields": []
      },
      "revokeDelegationAt(address _who, uint256 _blockNumber)": {
        "intent": "Revoke delegation at block",
        "fields": [
          {
            "label": "Who",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "path": "#._who",
            "visible": "always"
          },
          {
            "label": "Block Number",
            "format": "raw",
            "path": "#._blockNumber",
            "visible": "always"
          }
        ]
      },
      "delegateGovernance(address _to)": {
        "intent": "Delegate governance VP",
        "fields": [
          {
            "label": "To",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._to",
            "visible": "always"
          }
        ]
      },
      "undelegateGovernance()": {
        "intent": "Undelegate governance VP",
        "fields": []
      },
      "registerExecutor(uint256 _feeValue)": {
        "intent": "Register as claim executor",
        "fields": [
          {
            "label": "Executor Fee",
            "format": "amount",
            "path": "#._feeValue",
            "visible": "always"
          },
          {
            "label": "Registration fee (burned)",
            "format": "amount",
            "path": "@.value",
            "visible": "always"
          }
        ]
      },
      "updateExecutorFeeValue(uint256 _feeValue)": {
        "intent": "Schedule executor fee update",
        "fields": [
          {
            "label": "Fee Value",
            "format": "amount",
            "path": "#._feeValue",
            "visible": "always"
          }
        ]
      },
      "unregisterExecutor()": {
        "intent": "Unregister as claim executor",
        "fields": []
      }
    }
  }
}
