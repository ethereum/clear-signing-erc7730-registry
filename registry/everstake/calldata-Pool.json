{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "Everstake ETH staking pool",
    "contract": { "deployments": [{ "chainId": 1, "address": "0xD523794C879D9eC028960a231F866758e405bE34" }] }
  },
  "metadata": { "owner": "Everstake", "contractName": "Everstake ETH staking pool", "info": { "url": "https://everstake.com/" } },
  "display": {
    "formats": {
      "stake(uint64 source)": {
        "intent": "Stake",
        "interpolatedIntent": "Stake {@.value} with Everstake",
        "fields": [
          { "path": "@.value", "label": "Stake Amount", "format": "amount" },
          { "path": "source", "label": "Referral source", "visible": "never" }
        ]
      },
      "unstake(uint256 value,uint16 allowedInterchangeNum,uint64 source)": {
        "intent": "Unstake",
        "interpolatedIntent": "Unstake {value} from Everstake",
        "fields": [
          { "path": "value", "label": "Unstake Amount", "format": "amount" },
          { "path": "allowedInterchangeNum", "label": "Allowed interchanges", "visible": "never" },
          { "path": "source", "label": "Referral source", "visible": "never" }
        ]
      }
    }
  }
}
