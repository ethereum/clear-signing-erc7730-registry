{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ZKsync Lite Claim Contract",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x0a14B696350546110a0D8acDb86226983af9D2a0" }] }
  },
  "metadata": { "owner": "ZKsync", "contractName": "ZKsync Lite Claim Contract", "info": { "url": "https://lite.zksync.io/" } },
  "display": {
    "definitions": {
      "amount": {
        "label": "Amount to withdraw",
        "format": "tokenAmount",
        "params": { "tokenPath": "token", "nativeCurrencyAddress": ["0x0000000000000000000000000000000000000000"] }
      }
    },
    "formats": {
      "claim(uint256 index,address token,uint256 amount,bytes32[] merkleProof)": {
        "intent": "Withdraw ZKsync Lite funds",
        "interpolatedIntent": "Withdraw {amount} of your ZKsync Lite funds",
        "fields": [
          { "path": "amount", "$ref": "$.display.definitions.amount" },
          { "path": "index", "label": "Claim index", "visible": "never" },
          { "path": "token", "label": "Token", "visible": "never" },
          { "path": "merkleProof", "label": "Merkle proof", "visible": "never" }
        ]
      },
      "claimTo(uint256 index,address claimant,address token,uint256 amount,bytes32[] merkleProof)": {
        "intent": "Withdraw ZKsync Lite funds",
        "interpolatedIntent": "Withdraw {amount} of ZKsync Lite funds to {claimant}",
        "fields": [
          { "path": "amount", "$ref": "$.display.definitions.amount" },
          { "path": "claimant", "label": "Recipient", "format": "addressName", "params": { "types": ["eoa", "contract"] } },
          { "path": "index", "label": "Claim index", "visible": "never" },
          { "path": "token", "label": "Token", "visible": "never" },
          { "path": "merkleProof", "label": "Merkle proof", "visible": "never" }
        ]
      }
    }
  }
}
