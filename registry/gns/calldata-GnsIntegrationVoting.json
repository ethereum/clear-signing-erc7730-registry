{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 1, "address": "0xaA2c0f39F0b1a62A8aEB359bCd67874D2D145005" }] } },
  "metadata": { "owner": "Gwei Name Service", "contractName": "GnsIntegrationVoting", "info": { "url": "https://gwei.domains" } },
  "display": {
    "formats": {
      "cast((uint256 tokenId,bytes32[] integrationIds,uint16[] votes)[] ballots)": {
        "intent": "Vote on integrations",
        "fields": [
          {
            "path": "ballots.[].tokenId",
            "label": "Name",
            "format": "nftName",
            "params": { "collection": "0x9D51D507BC7264d4fE8Ad1cf7Fe191933A0a81d6" }
          },
          { "path": "ballots.[].integrationIds.[]", "label": "Integration", "visible": "never" },
          { "path": "ballots.[].votes.[]", "label": "Votes", "visible": "never" }
        ]
      }
    }
  }
}
