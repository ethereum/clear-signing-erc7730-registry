{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 1, "address": "0xA4283D56f523d05bBd46e483f7861d6D10Cb330A" }] } },
  "metadata": { "owner": "Gwei Name Service", "contractName": "HumanRegistrar", "info": { "url": "https://gwei.domains" } },
  "display": {
    "formats": {
      "claim((bytes32 version,(bytes32 vkeyHash,bytes proof,bytes32[] publicInputs) proofVerificationData,bytes committedInputs,(uint256 validityPeriodInSeconds,string domain,string scope,bool devMode) serviceConfig) params,string label)": {
        "intent": "Claim zkpassport.gwei name",
        "interpolatedIntent": "Claim {label}.zkpassport.gwei",
        "fields": [
          { "path": "label", "label": "Name", "format": "raw" },
          { "path": "params.version", "label": "Proof version", "visible": "never" },
          { "path": "params.proofVerificationData.vkeyHash", "label": "Verification key", "visible": "never" },
          { "path": "params.proofVerificationData.proof", "label": "Proof", "visible": "never" },
          { "path": "params.proofVerificationData.publicInputs.[]", "label": "Public inputs", "visible": "never" },
          { "path": "params.committedInputs", "label": "Committed inputs", "visible": "never" },
          { "path": "params.serviceConfig.validityPeriodInSeconds", "label": "Proof validity", "visible": "never" },
          { "path": "params.serviceConfig.domain", "label": "App domain", "visible": "never" },
          { "path": "params.serviceConfig.scope", "label": "Scope", "visible": "never" },
          { "path": "params.serviceConfig.devMode", "label": "Dev mode", "visible": "never" }
        ]
      }
    }
  }
}
