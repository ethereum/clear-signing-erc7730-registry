{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 1, "address": "0x9D51D507BC7264d4fE8Ad1cf7Fe191933A0a81d6" }] } },
  "metadata": {
    "owner": "Gwei Name Service",
    "contractName": "NameNFT",
    "info": { "url": "https://gwei.domains" },
    "enums": { "operatorAccess": { "true": "Grant all", "false": "Revoke all" } }
  },
  "display": {
    "definitions": {
      "name": { "label": "Name", "format": "nftName", "params": { "collectionPath": "@.to" } },
      "address": { "format": "addressName", "params": { "types": ["eoa", "wallet", "contract"], "sources": ["local", "ens"] } }
    },
    "formats": {
      "commit(bytes32 commitment)": { "intent": "Commit to register a name", "fields": [{ "path": "commitment", "label": "Commitment", "format": "raw" }] },
      "reveal(string label,bytes32 secret)": {
        "intent": "Register .gwei name",
        "interpolatedIntent": "Register {label}.gwei",
        "fields": [
          { "path": "label", "label": "Name (.gwei)", "format": "raw" },
          { "path": "@.value", "label": "Maximum payment", "format": "amount" },
          { "path": "secret", "label": "Secret", "visible": "never" }
        ]
      },
      "renew(uint256 tokenId)": {
        "intent": "Renew .gwei name for a year",
        "fields": [
          { "path": "tokenId", "$ref": "$.display.definitions.name" },
          { "path": "@.value", "label": "Maximum payment", "format": "amount" }
        ]
      },
      "registerSubdomain(string label,uint256 parentId)": {
        "intent": "Create subname",
        "fields": [
          { "path": "label", "label": "Subname", "format": "raw" },
          { "path": "parentId", "$ref": "$.display.definitions.name", "label": "Parent name" }
        ]
      },
      "registerSubdomainFor(string label,uint256 parentId,address to)": {
        "intent": "Create subname",
        "interpolatedIntent": "Create subname {label} for {to}",
        "fields": [
          { "path": "label", "label": "Subname", "format": "raw" },
          { "path": "parentId", "$ref": "$.display.definitions.name", "label": "Parent name" },
          { "path": "to", "$ref": "$.display.definitions.address", "label": "Owner" }
        ]
      },
      "setAddr(uint256 tokenId,address addr)": {
        "intent": "Set the address of a name",
        "interpolatedIntent": "Point name to {addr}",
        "fields": [
          { "path": "tokenId", "$ref": "$.display.definitions.name" },
          { "path": "addr", "$ref": "$.display.definitions.address", "label": "Address" }
        ]
      },
      "setAddrForCoin(uint256 tokenId,uint256 coinType,bytes addr)": {
        "intent": "Set an address of a name",
        "fields": [
          { "path": "tokenId", "$ref": "$.display.definitions.name" },
          { "path": "coinType", "label": "Coin type", "format": "raw" },
          { "path": "addr", "label": "Address", "format": "raw" }
        ]
      },
      "setContenthash(uint256 tokenId,bytes hash)": {
        "intent": "Set the website of a name",
        "fields": [{ "path": "tokenId", "$ref": "$.display.definitions.name" }, { "path": "hash", "label": "Content hash", "format": "raw" }]
      },
      "setText(uint256 tokenId,string key,string value)": {
        "intent": "Set a text record",
        "interpolatedIntent": "Set the {key} record",
        "fields": [
          { "path": "tokenId", "$ref": "$.display.definitions.name" },
          { "path": "key", "label": "Record", "format": "raw" },
          { "path": "value", "label": "Value", "format": "raw" }
        ]
      },
      "setPrimaryName(uint256 tokenId)": { "intent": "Set primary name", "fields": [{ "path": "tokenId", "$ref": "$.display.definitions.name" }] },
      "transferFrom(address from,address to,uint256 id)": {
        "intent": "Send .gwei name",
        "interpolatedIntent": "Send name to {to}",
        "fields": [
          { "path": "from", "$ref": "$.display.definitions.address", "label": "From" },
          { "path": "to", "$ref": "$.display.definitions.address", "label": "To" },
          { "path": "id", "$ref": "$.display.definitions.name" }
        ]
      },
      "safeTransferFrom(address from,address to,uint256 id)": {
        "intent": "Send .gwei name",
        "interpolatedIntent": "Send name to {to}",
        "fields": [
          { "path": "from", "$ref": "$.display.definitions.address", "label": "From" },
          { "path": "to", "$ref": "$.display.definitions.address", "label": "To" },
          { "path": "id", "$ref": "$.display.definitions.name" }
        ]
      },
      "safeTransferFrom(address from,address to,uint256 id,bytes data)": {
        "intent": "Send .gwei name",
        "interpolatedIntent": "Send name to {to}",
        "fields": [
          { "path": "from", "$ref": "$.display.definitions.address", "label": "From" },
          { "path": "to", "$ref": "$.display.definitions.address", "label": "To" },
          { "path": "id", "$ref": "$.display.definitions.name" },
          { "path": "data", "label": "Data", "visible": "never" }
        ]
      },
      "approve(address account,uint256 id)": {
        "intent": "Approve operator for a name",
        "interpolatedIntent": "Let {account} move a name",
        "fields": [
          { "path": "account", "$ref": "$.display.definitions.address", "label": "Operator" },
          { "path": "id", "$ref": "$.display.definitions.name" }
        ]
      },
      "setApprovalForAll(address operator,bool isApproved)": {
        "intent": "Manage operator for all names",
        "fields": [
          { "path": "operator", "$ref": "$.display.definitions.address", "label": "Operator" },
          { "path": "isApproved", "label": "Access", "format": "enum", "params": { "$ref": "$.metadata.enums.operatorAccess" } }
        ]
      }
    }
  }
}
