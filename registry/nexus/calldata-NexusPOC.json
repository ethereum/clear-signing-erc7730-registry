{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "NEXUS Protocol POC",
    "contract": {
      "deployments": [
        { "chainId": 84532, "address": "0x471796C1644d87f30AD81D36f6d4A56f0e270c23" }
      ]
    }
  },
  "metadata": {
    "owner": "NEXUS Protocol (avp9)",
    "info": { "url": "https://nexus-art.org", "deploymentDate": "2026-05-30T15:03:16Z" },
    "enums": {
      "rights": { "True": "Grant all", "False": "Deny all" },
      "whitelist": { "True": "Grant", "False": "Revoke" }
    }
  },
  "display": {
    "formats": {
      "placeBid(uint256 tokenId)": {
        "intent": "Place bid on artwork",
        "interpolatedIntent": "Bid {@.value} on artwork {tokenId}",
        "fields": [
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" },
          { "path": "@.value", "label": "Bid amount", "format": "amount" }
        ]
      },
      "settleAuction(uint256 tokenId)": {
        "intent": "Settle auction",
        "interpolatedIntent": "Settle auction for artwork {tokenId}",
        "fields": [
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" }
        ]
      },
      "startAuction(uint256 tokenId,uint256 reservePrice,uint256 duration)": {
        "intent": "Start auction",
        "interpolatedIntent": "Start auction for artwork {tokenId}, reserve {reservePrice}, duration {duration}",
        "fields": [
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" },
          { "path": "reservePrice", "label": "Reserve price", "format": "amount" },
          { "path": "duration", "label": "Duration", "format": "duration" }
        ]
      },
      "setAgentWhitelist(address agent,bool allowed)": {
        "intent": "Whitelist bidding agent",
        "interpolatedIntent": "{allowed} bidding access for agent {agent}",
        "fields": [
          { "path": "agent", "label": "Agent address", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "allowed", "label": "Access", "format": "enum", "params": { "$ref": "$.metadata.enums.whitelist" } }
        ]
      },
      "mintWork(address creator,string uri,uint96 royaltyBps)": {
        "intent": "Mint artwork",
        "interpolatedIntent": "Mint artwork {uri} for creator {creator} with {royaltyBps} royalty",
        "fields": [
          { "path": "creator", "label": "Creator (royalty)", "format": "addressName", "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] } },
          { "path": "uri", "label": "Metadata URI", "format": "raw" },
          { "path": "royaltyBps", "label": "Royalty", "format": "unit", "params": { "base": "%", "decimals": 2 } }
        ]
      },
      "setCuratorRecipient(address newCurator)": {
        "intent": "Set curator wallet",
        "interpolatedIntent": "Set curator wallet to {newCurator}",
        "fields": [
          { "path": "newCurator", "label": "New curator address", "format": "addressName", "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] } }
        ]
      },
      "setPlatformRecipient(address newPlatform)": {
        "intent": "Set platform wallet",
        "interpolatedIntent": "Set platform wallet to {newPlatform}",
        "fields": [
          { "path": "newPlatform", "label": "New platform address", "format": "addressName", "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] } }
        ]
      },
      "transferOwnership(address newOwner)": {
        "intent": "Transfer ownership",
        "interpolatedIntent": "Transfer contract ownership to {newOwner}",
        "fields": [
          { "path": "newOwner", "label": "New owner address", "format": "addressName", "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] } }
        ]
      },
      "renounceOwnership()": {
        "intent": "Renounce ownership FOREVER",
        "interpolatedIntent": "Renounce ownership of this contract FOREVER",
        "fields": []
      },
      "setApprovalForAll(address operator,bool approved)": {
        "intent": "Approve ALL artworks",
        "interpolatedIntent": "{approved}: operator {operator} on ALL artworks of {@.to}",
        "fields": [
          { "path": "@.to", "label": "Collection", "format": "addressName", "params": { "types": ["collection"], "sources": ["local", "ens"] } },
          { "path": "operator", "label": "Operator address", "format": "addressName", "params": { "types": ["contract"], "sources": ["local", "ens"] } },
          { "path": "approved", "label": "Access rights", "format": "enum", "params": { "$ref": "$.metadata.enums.rights" } }
        ]
      },
      "approve(address to,uint256 tokenId)": {
        "intent": "Approve one artwork",
        "interpolatedIntent": "Approve {to} to transfer artwork {tokenId}",
        "fields": [
          { "path": "to", "label": "Operator address", "format": "addressName", "params": { "types": ["contract"], "sources": ["local", "ens"] } },
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" }
        ]
      },
      "transferFrom(address from,address to,uint256 tokenId)": {
        "intent": "Transfer artwork",
        "interpolatedIntent": "Transfer artwork {tokenId} from {from} to {to}",
        "fields": [
          { "path": "from", "label": "From", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "to", "label": "To", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" }
        ]
      },
      "safeTransferFrom(address from,address to,uint256 tokenId)": {
        "intent": "Transfer artwork",
        "interpolatedIntent": "Transfer artwork {tokenId} from {from} to {to}",
        "fields": [
          { "path": "from", "label": "From", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "to", "label": "To", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" }
        ]
      },
      "safeTransferFrom(address from,address to,uint256 tokenId,bytes data)": {
        "intent": "Transfer artwork",
        "interpolatedIntent": "Transfer artwork {tokenId} from {from} to {to}",
        "fields": [
          { "path": "from", "label": "From", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "to", "label": "To", "format": "addressName", "params": { "types": ["eoa"], "sources": ["local", "ens"] } },
          { "path": "tokenId", "label": "Artwork (tokenId)", "format": "raw" },
          { "path": "data", "label": "Extra data", "format": "raw" }
        ]
      }
    }
  }
}
