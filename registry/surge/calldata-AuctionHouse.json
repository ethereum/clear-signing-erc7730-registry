{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "AuctionHouse",
    "contract": { "deployments": [{ "chainId": 8453, "address": "0xE5Ff1E177dDE3FC33f5457855b14e6bD3B0C6566" }] }
  },
  "metadata": { "owner": "Surge", "info": { "url": "https://surge.credit" }, "contractName": "AuctionHouse" },
  "display": {
    "formats": {
      "buy(uint256 nftId_,bytes btcAddress_)": {
        "$id": "buy",
        "intent": "Buy Surge auction",
        "interpolatedIntent": "Buy Surge vault {nftId_}",
        "fields": [
          { "path": "nftId_", "label": "Vault", "format": "raw" },
          { "path": "btcAddress_", "label": "BTC address (hex)", "format": "raw" }
        ]
      }
    }
  }
}
