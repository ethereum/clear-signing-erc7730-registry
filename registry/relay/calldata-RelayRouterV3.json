{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "RelayRouterV3",
    "contract": { "deployments": [{ "chainId": 137, "address": "0xB92fe925DC43a0ECdE6c8b1a2709c170Ec4fFf4f" }] }
  },
  "metadata": { "owner": "Relay", "contractName": "RelayRouterV3", "info": { "url": "https://relay.link" } },
  "display": {
    "formats": {
      "multicall((address target, bool allowFailure, uint256 value, bytes callData)[] calls, address refundTo, address nftRecipient, bytes metadata)": {
        "$id": "multicall",
        "intent": "Relay multicall",
        "interpolatedIntent": "Send {@.value} via Relay",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount", "visible": "always" },
          { "path": "calls.[].target", "label": "Call target", "visible": "never" },
          { "path": "calls.[].allowFailure", "label": "Allow failure", "visible": "never" },
          { "path": "calls.[].value", "label": "Call value", "visible": "never" },
          { "path": "calls.[].callData", "label": "Call data", "visible": "never" },
          { "path": "refundTo", "label": "Refund to", "visible": "never" },
          { "path": "nftRecipient", "label": "NFT recipient", "visible": "never" },
          { "path": "metadata", "label": "Metadata", "visible": "never" }
        ]
      }
    }
  }
}
