{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "42 FTControllerV2",
    "contract": {
      "deployments": [
        { "chainId": 56, "address": "0x8Fe93361D2B8b9519C4d20d47a319288Feec9072" },
        { "chainId": 56, "address": "0xA2098a07F12A788000465743aa9F5aCc76A036a7" }
      ]
    }
  },
  "metadata": { "owner": "42", "contractName": "FTControllerV2", "info": { "url": "https://42.space" } },
  "display": {
    "formats": {
      "flag(bytes32 questionId)": {
        "intent": "Flag market",
        "interpolatedIntent": "Flag market {questionId}",
        "fields": [{ "path": "#.questionId", "label": "Question ID", "format": "raw" }]
      },
      "unflag(bytes32 questionId)": {
        "intent": "Unflag market",
        "interpolatedIntent": "Unflag market {questionId}",
        "fields": [{ "path": "#.questionId", "label": "Question ID", "format": "raw" }]
      },
      "finaliseManually(bytes32 questionId,uint256 answer)": {
        "intent": "Finalise manually",
        "interpolatedIntent": "Finalise manually as {answer}",
        "fields": [
          { "path": "#.questionId", "label": "Question ID", "format": "raw" },
          { "path": "#.answer", "label": "Answer (outcome bitmap)", "format": "raw" }
        ]
      }
    }
  }
}
