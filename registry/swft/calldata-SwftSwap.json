      "swap(address fromToken,string toToken,string destination,uint256 fromAmount,uint256 minReturnAmount)": {
        "intent": "Send to SWFT for swap",
        "fields": [
          { "label": "Note", "value": "Paid out off-chain by SWFT. The minimum is not enforced on-chain.", "format": "raw" },
          { "path": "fromAmount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "fromToken" } },
          { "path": "toToken", "label": "Order Details", "format": "raw" },
          { "path": "destination", "label": "Payout Address", "format": "raw" },
          { "path": "minReturnAmount", "label": "Requested Min (raw)", "format": "raw" },
          { "path": "fromToken", "label": "From Token", "visible": "never" }
        ],
        "interpolatedIntent": "Send {fromAmount} to SWFT to swap for {toToken}, paid to {destination}, requested minimum {minReturnAmount} (raw units)"
      },
      "swapEth(string toToken,string destination,uint256 minReturnAmount)": {
        "intent": "Send to SWFT for swap",
        "fields": [
          { "label": "Note", "value": "Paid out off-chain by SWFT. The minimum is not enforced on-chain.", "format": "raw" },
          { "path": "@.value", "label": "Amount", "format": "amount" },
          { "path": "toToken", "label": "Order Details", "format": "raw" },
          { "path": "destination", "label": "Payout Address", "format": "raw" },
          { "path": "minReturnAmount", "label": "Requested Min (raw)", "format": "raw" }
        ],
        "interpolatedIntent": "Send {@.value} to SWFT to swap for {toToken}, paid to {destination}, requested minimum {minReturnAmount} (raw units)"
      }
