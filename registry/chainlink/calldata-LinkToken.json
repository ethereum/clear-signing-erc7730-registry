{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "includes": "../../ercs/calldata-erc20-tokens.json",
  "context": {
    "$id": "LinkToken",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x514910771AF9Ca656af840dff83E8264EcF986CA" }] }
  },
  "metadata": { "owner": "Chainlink", "info": { "url": "https://chain.link" }, "contractName": "LinkToken" },
  "display": {
    "formats": {
      "transferAndCall(address _to, uint256 _value, bytes _data)": {
        "intent": "Send LINK and call contract",
        "interpolatedIntent": "Send {_value} and call {_to}",
        "fields": [
          { "path": "#._value", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "@.to" }, "visible": "always" },
          {
            "path": "#._to",
            "label": "To",
            "format": "addressName",
            "params": { "types": ["contract", "eoa"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          { "path": "#._data", "label": "Data", "format": "raw", "visible": "always" }
        ]
      }
    }
  }
}
