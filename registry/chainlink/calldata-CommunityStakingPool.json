{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "CommunityStakingPool",
    "contract": { "deployments": [{ "chainId": 1, "address": "0xBc10f2E862ED4502144c7d632a3459F49DFCDB5e" }] }
  },
  "metadata": {
    "owner": "Chainlink",
    "info": { "url": "https://chain.link" },
    "constants": { "linkToken": "0x514910771AF9Ca656af840dff83E8264EcF986CA" },
    "contractName": "CommunityStakingPool"
  },
  "display": {
    "formats": {
      "unstake(uint256 amount)": {
        "intent": "Unstake LINK, forfeit unvested",
        "fields": [
          {
            "path": "#.amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.linkToken" },
            "visible": "always"
          }
        ]
      }
    }
  }
}
