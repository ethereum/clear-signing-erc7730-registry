{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        { "chainId": 270, "address": "0x0000000000000000000000000000000000000801" },
        { "chainId": 2700, "address": "0x0000000000000000000000000000000000000801" }
      ]
    }
  },
  "metadata": { "owner": "Orbinum", "contractName": "ShieldedPool", "info": { "url": "https://orbinum.network" } },
  "display": {
    "formats": {
      "shield(uint32 assetId,bytes32 commitment,bytes encryptedMemo,bytes proof,uint32 circuitVersion)": {
        "intent": "Shield to private pool",
        "interpolatedIntent": "Shield {@.value}",
        "fields": [
          { "path": "@.value", "label": "Amount", "format": "amount" },
          { "path": "assetId", "label": "Asset ID", "format": "raw" },
          { "path": "commitment", "label": "Note commitment", "format": "raw" },
          { "path": "circuitVersion", "label": "Circuit version", "format": "raw", "visible": "optional" },
          { "path": "encryptedMemo", "label": "Encrypted memo", "format": "raw", "visible": "never" },
          { "path": "proof", "label": "Zero-knowledge proof", "format": "raw", "visible": "never" }
        ]
      }
    }
  }
}
