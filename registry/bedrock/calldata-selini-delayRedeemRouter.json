{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "seliniDelayRedeemRouter",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x641dc9E75A1b0a4c011926C4Aa1BB4721778EC2a" }
      ]
    }
  },
  "metadata": { "owner": "Bedrock", "info": { "url": "https://bedrock.technology" }, "contractName": "Bedrock suniBTC DelayRedeemRouter (Selini)" },
  "display": {
    "formats": {
      "createDelayedRedeem(address token, uint256 amount)": {
        "$id": "createDelayedRedeem",
        "intent": "Create a delayed redeem",
        "interpolatedIntent": "Redeem {amount} with a delay",
        "fields": [
          {
            "path": "#.token",
            "label": "Token",
            "format": "addressName",
            "params": { "types": ["token", "contract"] },
            "visible": "always"
          },
          {
            "path": "#.amount",
            "label": "Amount to Redeem",
            "format": "tokenAmount",
            "params": { "tokenPath": "#.token" },
            "visible": "always"
          }
        ]
      },
      "claimDelayedRedeems()": {
        "$id": "claimDelayedRedeems",
        "intent": "Claim delayed redeems",
        "interpolatedIntent": "Claim all delayed redeems",
        "fields": []
      }
    }
  }
}
