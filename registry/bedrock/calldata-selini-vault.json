{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "seliniVault",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0xB8b0aEd0a1Ce913183665B71bD9653fe378f2230" }
      ]
    }
  },
  "metadata": { "owner": "Bedrock", "info": { "url": "https://bedrock.technology" }, "contractName": "Bedrock suniBTC Vault (Selini)" },
  "display": {
    "formats": {
      "mint(address _token, uint256 _amount)": {
        "$id": "mint",
        "intent": "Mint with wrapped BTC",
        "interpolatedIntent": "Mint suniBTC by depositing {_amount}",
        "fields": [
          {
            "path": "#._token",
            "label": "Token",
            "format": "addressName",
            "params": { "types": ["token", "contract"] },
            "visible": "always"
          },
          {
            "path": "#._amount",
            "label": "Amount to Deposit",
            "format": "tokenAmount",
            "params": { "tokenPath": "#._token" },
            "visible": "always"
          }
        ]
      }
    }
  }
}
