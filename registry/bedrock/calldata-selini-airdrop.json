{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "seliniAirdrop",
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x9eB0ba9722f2F60ef87E569628eC99f952974307" }
      ]
    }
  },
  "metadata": { "owner": "Bedrock", "info": { "url": "https://bedrock.technology" }, "contractName": "Bedrock suniBTC Airdrop (Selini)" },
  "display": {
    "formats": {
      "claim(uint256 _amount, bytes32[] _proof, uint256 _epoch)": {
        "$id": "claim",
        "intent": "Claim airdrop",
        "interpolatedIntent": "Claim {_amount} for epoch {_epoch}",
        "fields": [
          {
            "path": "#._amount",
            "label": "Amount",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#._epoch",
            "label": "Epoch",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#._proof",
            "label": "Proof",
            "format": "raw",
            "visible": "never"
          }
        ]
      }
    }
  }
}
