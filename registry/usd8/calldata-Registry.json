  "display": {
    "formats": {
      "upgradeToAndCall(address newImplementation, bytes data)": {
        "intent": "Upgrade Contract",
        "interpolatedIntent": "Upgrade to {newImplementation} and run setup call",
        "fields": [
          {
            "path": "#.newImplementation",
            "label": "New Implementation",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          },
          {
            "path": "#.data",
            "label": "Setup Call Data",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "ETH Sent",
            "format": "amount",
            "visible": "optional"
          }
        ]
      },
      "addPool(address pool, address usdFeed)": {
        "intent": "Add Cover Pool",
        "interpolatedIntent": "Register cover pool {pool} with USD feed {usdFeed}",
        "fields": [
          {
            "path": "#.pool",
            "label": "Pool",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          },
          {
            "path": "#.usdFeed",
            "label": "USD Feed",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          }
        ]
      },
