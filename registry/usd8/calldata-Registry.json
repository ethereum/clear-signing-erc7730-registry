{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "USD8 Registry",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x9BfF24a44Bb20F8D1f1dE86EcA56295c5Bb46430"
        }
      ]
    }
  },
  "metadata": {
    "owner": "USD8",
    "info": {
      "url": "https://usd8.fi"
    },
    "contractName": "Registry"
