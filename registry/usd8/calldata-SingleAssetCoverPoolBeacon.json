{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "USD8 Cover Pool Beacon",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0xf8954aeE7e73acc7444a07617a690ef40ca89a8F"
        }
      ]
    }
  },
  "metadata": {
    "owner": "USD8",
    "info": {
      "url": "https://usd8.fi"
    },
    "contractName": "UpgradeableBeacon"
  },
  "display": {
    "formats": {
      "upgradeTo(address newImplementation)": {
        "intent": "Upgrade Cover Pools",
        "interpolatedIntent": "Upgrade all cover pools to {newImplementation}",
        "fields": [
          {
            "path": "#.newImplementation",
            "label": "New Implementation",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          }
        ]
      },
      "transferOwnership(address newOwner)": {
        "intent": "Transfer Beacon Owner",
        "interpolatedIntent": "Transfer cover pool beacon ownership to {newOwner}",
        "fields": [
          {
            "path": "#.newOwner",
            "label": "New Owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          }
        ]
      },
      "renounceOwnership()": {
        "intent": "Renounce Beacon Owner",
        "interpolatedIntent": "Permanently renounce cover pool beacon ownership",
        "fields": []
      }
    }
  }
}
