            "visible": "always"
          },
          {
            "path": "#.ids.[]",
            "label": "Booster Types",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.tokenId"
            },
            "visible": "always"
          },
          {
            "path": "#.values.[]",
            "label": "Amounts",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
      "mint(address to, uint256 tokenId, uint256 amount)": {
        "intent": "Admin Mint USD8 Booster",
        "interpolatedIntent": "Mint {amount} {tokenId} to {to}",
        "fields": [
          {
            "path": "#.to",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          },
          {
            "path": "#.tokenId",
            "label": "Booster Type",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.tokenId"
            },
            "visible": "always"
          },
          {
            "path": "#.amount",
            "label": "Amount",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
      "mintBatch(address[] recipients, uint256[] tokenIds, uint256[] amounts)": {
        "intent": "Admin Mint USD8 Boosters",
        "interpolatedIntent": "Mint a batch of boosters",
        "fields": [
          {
            "path": "#.recipients.[]",
            "label": "Recipients",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
