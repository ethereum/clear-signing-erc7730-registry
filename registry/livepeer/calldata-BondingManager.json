      "unbondWithHint(uint256 _amount, address _newPosPrev, address _newPosNext)": {
        "intent": "Undelegate LPT; full unbond resigns orchestrator",
        "interpolatedIntent": "Undelegate {_amount}; a full unbond resigns an orchestrator",
        "fields": [
          {
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.LPTaddress"
            },
            "path": "#._amount",
            "visible": "always"
          },
          {
            "label": "List hint (prev)",
            "path": "#._newPosPrev",
            "visible": "never"
          },
          {
            "label": "List hint (next)",
            "path": "#._newPosNext",
            "visible": "never"
          }
