{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "BondingManager",
    "contract": {
      "deployments": [
        {
          "chainId": 42161,
          "address": "0x35Bcf3c30594191d53231E4FF333E8A770453e40"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Livepeer",
    "info": {
      "url": "https://livepeer.org"
    },
    "constants": {
      "LPTaddress": "0x289ba1701C2F088cf0faf8B3705246331cB8A839"
