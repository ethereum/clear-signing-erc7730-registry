            "label": "List hint 2",
            "path": "#._oldDelegateNewPosNext",
            "visible": "never"
          },
          {
            "label": "List hint 3",
            "path": "#._currDelegateNewPosPrev",
            "visible": "never"
          },
          {
            "label": "List hint 4",
            "path": "#._currDelegateNewPosNext",
            "visible": "never"
