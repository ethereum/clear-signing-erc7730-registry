{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ALIA Agent Identity Registry Base",
    "contract": {
      "deployments": [{ "chainId": 8453, "address": "0xD5667AcB0Ac8108B45f6CDD4774559264098f8de" }]
    }
  },
  "metadata": { "owner": "ALIA Quality Network", "info": { "url": "https://avvatar.io", "deploymentDate": "2026-04-06T10:46:58Z" }, "enums": { "agentStatus": { "0": "Pending", "1": "Active", "2": "Suspended", "3": "Revoked" }, "agentType": { "0": "Digital", "1": "Physical", "2": "Hybrid" } } },
  "display": {
    "formats": {
      "recordDecision(address _agent, string _action, address _assetInvolved, uint256 _value, bool _success, bytes32 _txHash)": {
        "$id": "agent_decision",
        "intent": "Record A2A decision",
        "fields": [
          { "path": "_agent", "label": "Agent", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_action", "label": "Action", "format": "raw" },
          { "path": "_assetInvolved", "label": "Asset", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "_value", "label": "Value", "format": "raw" },
          { "path": "_success", "label": "Success", "format": "raw" },
          { "path": "_txHash", "label": "Tx Hash", "format": "raw" }
        ]
      },
      "recordIncident(address _agent, string _description)": {
        "$id": "agent_incident",
        "intent": "Record agent incident",
        "fields": [
          { "path": "_agent", "label": "Agent", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_description", "label": "Description", "format": "raw" }
        ]
      },
      "registerAgent(address _agentWallet, address _ownerWallet, uint8 _agentType, string _name, string _version, string _manufacturer, string _serialNumber, uint256 _minColScore, uint256 _maxLTV)": {
        "$id": "agent_register",
        "intent": "Register agent ERC-8240",
        "fields": [
          { "path": "_agentWallet", "label": "Agent Wallet", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_ownerWallet", "label": "Owner Wallet", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_agentType", "label": "Agent Type", "format": "enum", "params": { "$ref": "$.metadata.enums.agentType" } },
          { "path": "_name", "label": "Name", "format": "raw" },
          { "path": "_version", "label": "Version", "format": "raw" },
          { "path": "_manufacturer", "label": "Manufacturer", "format": "raw" },
          { "path": "_serialNumber", "label": "Serial", "format": "raw" },
          { "path": "_minColScore", "label": "Min Score", "format": "raw" },
          { "path": "_maxLTV", "label": "Max LTV", "format": "raw" }
        ]
      },
      "updateAgentStatus(address _agent, uint8 _newStatus, string _reason)": {
        "$id": "agent_status",
        "intent": "Update agent status",
        "fields": [
          { "path": "_agent", "label": "Agent", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_newStatus", "label": "Status", "format": "enum", "params": { "$ref": "$.metadata.enums.agentStatus" } },
          { "path": "_reason", "label": "Reason", "format": "raw" }
        ]
      },
      "updateFirmware(address _agent, string _newVersion)": {
        "$id": "agent_firmware",
        "intent": "Update agent firmware",
        "fields": [
          { "path": "_agent", "label": "Agent", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "_newVersion", "label": "New version", "format": "raw" }
        ]
      }
    }
  }
}
