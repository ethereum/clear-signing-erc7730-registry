{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ALIA Asset Identity Registry Base",
    "contract": {
      "deployments": [{ "chainId": 8453, "address": "0xfC9cA736d384D482af5d23CC7616765C66244D29" }]
    }
  },
  "metadata": { "owner": "ALIA Quality Network", "info": { "url": "https://avvatar.io", "deploymentDate": "2026-04-06T10:46:58Z" }, "enums": { "assetClass": { "0": "Bonds", "1": "Equities", "2": "Real estate", "3": "Precious metals", "4": "Carbon credits", "5": "Private equity", "6": "Physical assets", "7": "Commodities", "8": "Private credit", "9": "Digital assets" }, "backingType": { "0": "Physically backed", "1": "Synthetic exposure", "2": "Fractional", "3": "Pooled" } } },
  "display": {
    "formats": {
      "addCrossChainRecord(address _tokenAddress, uint256 _chainId, address _crossChainToken)": {
        "$id": "asset_crosschain",
        "intent": "Add cross-chain record",
        "fields": [
          { "path": "_tokenAddress", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "_chainId", "label": "Chain ID", "format": "raw" },
          { "path": "_crossChainToken", "label": "Cross Chain Token", "format": "addressName", "params": { "types": ["token"] } }
        ]
      },
      "registerAsset(address _tokenAddress, uint8 _assetClass, uint8 _backingType, string _legalIdentifier, string _jurisdiction, string _custodian)": {
        "$id": "asset_register",
        "intent": "Register asset ERC-8240",
        "fields": [
          { "path": "_tokenAddress", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "_assetClass", "label": "Asset class", "format": "enum", "params": { "$ref": "$.metadata.enums.assetClass" } },
          { "path": "_backingType", "label": "Backing", "format": "enum", "params": { "$ref": "$.metadata.enums.backingType" } },
          { "path": "_legalIdentifier", "label": "Legal ID", "format": "raw" },
          { "path": "_jurisdiction", "label": "Jurisdiction", "format": "raw" },
          { "path": "_custodian", "label": "Custodian", "format": "raw" }
        ]
      },
      "revokeAsset(address _tokenAddress, string _reason)": {
        "$id": "asset_revoke",
        "intent": "Revoke asset",
        "fields": [
          { "path": "_tokenAddress", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "_reason", "label": "Reason", "format": "raw" }
        ]
      },
      "updateCustodian(address _tokenAddress, string _newCustodian)": {
        "$id": "asset_custodian",
        "intent": "Update asset custodian",
        "fields": [
          { "path": "_tokenAddress", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "_newCustodian", "label": "Custodian", "format": "raw" }
        ]
      }
    }
  }
}
