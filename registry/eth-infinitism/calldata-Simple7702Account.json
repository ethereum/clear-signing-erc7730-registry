              "components": [
                { "name": "target", "type": "address", "internalType": "address" },
                { "name": "value", "type": "uint256", "internalType": "uint256" },
                { "name": "data", "type": "bytes", "internalType": "bytes" }
              ]
            }
          ],
          "outputs": [],
          "stateMutability": "payable"
        }
      ],
      "deployments": [
        { "chainId": 1, "address": "0x4Cd241E8d1510e30b2076397afc7508Ae59C66c9" },
        { "chainId": 10, "address": "0x4Cd241E8d1510e30b2076397afc7508Ae59C66c9" },
        { "chainId": 8453, "address": "0x4Cd241E8d1510e30b2076397afc7508Ae59C66c9" },
