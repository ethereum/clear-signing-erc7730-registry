  "display": {
    "formats": {
      "execute(address target, uint256 value, bytes data)": {
        "$id": "execute",
        "intent": "Run an action",
        "fields": [
          {
            "path": "target",
            "label": "Contract",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "data",
            "label": "Action",
            "format": "calldata",
            "params": { "calleePath": "target", "amountPath": "value" },
            "visible": "always"
          }
        ]
      },
      "executeBatch((address target, uint256 value, bytes data)[] calls)": {
        "$id": "executeBatch",
        "intent": "Run several actions at once",
        "fields": [
          {
            "path": "calls.[].target",
            "label": "Contract",
            "format": "addressName",
            "params": { "types": ["contract"], "sources": ["local", "ens"] },
            "visible": "always"
          },
          {
            "path": "calls.[].data",
            "label": "Action",
            "format": "calldata",
            "params": { "calleePath": "calls.[].target", "amountPath": "calls.[].value" },
            "visible": "always"
          }
        ]
      }
    }
  }
