{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ENS ReverseRegistrar",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0xa58e81fe9b61b5c3fe2afd33cf304c454abfc7cb"
        }
      ]
    }
  },
  "metadata": {
    "owner": "ENS",
    "contractName": "ReverseRegistrar",
    "info": {
      "url": "https://ens.domains"
    }
  },
  "display": {
    "formats": {
      "setName(string name)": {
        "intent": "Set your primary ENS name",
        "interpolatedIntent": "Set your primary ENS name to {name}",
        "fields": [
          {
            "path": "name",
            "label": "Name",
            "format": "raw"
          }
        ]
      },
      "setNameForAddr(address addr,address owner,address resolver,string name)": {
        "intent": "Set primary ENS name",
        "interpolatedIntent": "Set {addr}'s primary ENS name to {name}",
        "fields": [
          {
            "path": "addr",
            "label": "For",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          },
          {
            "path": "name",
            "label": "Name",
            "format": "raw"
          },
          {
            "path": "owner",
            "label": "Owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          },
          {
            "path": "resolver",
            "label": "Resolver",
            "visible": "never"
          }
        ]
      }
    }
  }
}
