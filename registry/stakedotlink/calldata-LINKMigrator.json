{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "LINKMigrator",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x08E11a9A74E7aCc51aCe382b6D02aBE8B7cF7786" }] }
  },
  "metadata": {
    "owner": "stake.link",
    "info": { "url": "https://stake.link" },
    "constants": { "linkToken": "0x514910771AF9Ca656af840dff83E8264EcF986CA" },
    "contractName": "LINKMigrator"
  },
  "display": {
    "formats": {
      "initiateMigration(uint256 _amount)": {
        "intent": "Migrate staked LINK to stLINK",
        "interpolatedIntent": "Migrate {_amount} to stLINK",
        "fields": [
          {
            "label": "Amount",
            "format": "tokenAmount",
            "path": "#._amount",
            "params": { "token": "$.metadata.constants.linkToken" },
            "visible": "always"
          }
        ]
      }
    }
  }
}
